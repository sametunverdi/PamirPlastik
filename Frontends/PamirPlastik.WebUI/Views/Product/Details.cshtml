@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model PamirPlastik.WebUI.DTOs.ProductDtos.ResultProductDto
@{
        var nTr = Model?.Name_TR;
    var nEn = !string.IsNullOrWhiteSpace(Model?.Name_EN) ? Model?.Name_EN : nTr;
    var name = Localizer.CurrentLanguage == "en" ? nEn : nTr;
    
    var sTr = Model?.ShortDescription_TR;
    var sEn = !string.IsNullOrWhiteSpace(Model?.ShortDescription_EN) ? Model?.ShortDescription_EN : sTr;
    var shortDesc = Localizer.CurrentLanguage == "en" ? sEn : sTr;
    
    ViewData["Title"] = Localizer.Get("Ürünler / ", "Products / ") + (name ?? Localizer.Get("Ürün Detayı", "Product Detail"));
    ViewData["Description"] = shortDesc;
    ViewData["PageName"] = Localizer.Get("Ürün Kataloğu", "Product Catalog");
    ViewData["HeaderTitle"] = name ?? Localizer.Get("Ürün Detayı", "Product Detail");
}

<style>
    body { background-color: #f8fafc; }
    .thumb-btn.active { border-color: #6366f1; opacity: 1; transform: scale(1.05); }
    .thumb-btn { transition: all 0.3s ease; }
    
    /* Lightbox Modal CSS */
    #lightbox { display: none; }
    #lightbox.show { display: flex; animation: fadeIn 0.3s forwards; }
    @@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

<section class="py-8 lg:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-[2.5rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 p-6 lg:p-12">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
                
                <!-- Sol Kolon: Galeri -->
                <div class="lg:col-span-5 flex flex-col gap-6">
                    <div class="relative bg-slate-50 rounded-3xl p-6 border border-slate-100 aspect-square flex items-center justify-center group overflow-hidden">
                        
                        <!-- Sol Ok -->
                        <button onclick="prevImage(event)" class="absolute left-4 z-10 w-10 h-10 bg-white/80 hover:bg-white text-indigo-600 rounded-full shadow-md flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>

                        <img id="main-image" src="@Model?.MainImageUrl" alt="@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.Name_EN) ? Model?.Name_EN : Model?.Name_TR)" class="max-w-full max-h-full object-contain rounded-2xl drop-shadow-xl transition-all duration-500 cursor-zoom-in group-hover:scale-105" onclick="openLightbox(this.src)" />
                        
                        <!-- Sağ Ok -->
                        <button onclick="nextImage(event)" class="absolute right-4 z-10 w-10 h-10 bg-white/80 hover:bg-white text-indigo-600 rounded-full shadow-md flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 transform translate-x-4 group-hover:translate-x-0">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        
                        <div class="absolute bottom-4 right-4 pointer-events-none bg-white/90 backdrop-blur-md w-10 h-10 rounded-full flex items-center justify-center shadow-lg text-slate-600 opacity-0 group-hover:opacity-100 transition-opacity">
                            <i class="fa-solid fa-expand"></i>
                        </div>
                        
                        @if (Model?.IsFeatured == true)
                        {
                            <span class="absolute top-6 left-6 z-10 bg-[#ffda44] text-[#0f172a] text-[10px] font-black px-3 py-1.5 rounded-full uppercase tracking-widest shadow-lg flex items-center gap-2">
                                <i class="fa-solid fa-star"></i> @Localizer.Get("Yıldız Ürün", "Featured")
                            </span>
                        }
                    </div>

                    <div class="flex gap-4 overflow-x-auto pb-2 px-1 snap-x hide-scrollbar" id="thumbnail-container">
                        <!-- Ana resim her zaman ilk thumbnail -->
                        <button data-src="@Model?.MainImageUrl" onclick="changeImage(this, '@Model?.MainImageUrl')" class="thumb-btn active snap-start flex-none w-20 h-20 rounded-2xl border-2 border-indigo-600 bg-slate-50 p-2 focus:outline-none">
                            <img src="@Model?.MainImageUrl" class="w-full h-full object-contain rounded-xl pointer-events-none" />
                        </button>
                        
                        @if (Model?.Images != null && Model.Images.Any())
                        {
                            foreach (var img in Model.Images.Where(i => i.ImageUrl != Model.MainImageUrl))
                            {
                                <button data-src="@img.ImageUrl" onclick="changeImage(this, '@img.ImageUrl')" class="thumb-btn opacity-70 snap-start flex-none w-20 h-20 rounded-2xl border-2 border-slate-200 bg-slate-50 p-2 hover:border-indigo-300 focus:outline-none">
                                    <img src="@img.ImageUrl" class="w-full h-full object-contain rounded-xl pointer-events-none" />
                                </button>
                            }
                        }
                    </div>
                </div>

                <!-- Sağ Kolon: Bilgiler -->
                <div class="lg:col-span-7 flex flex-col justify-center">
                    
                    <div class="mb-6">
                        <div class="flex items-center gap-3 mb-4">
                            <span class="inline-block px-3 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded-lg tracking-wider uppercase border border-slate-200">
                                @Localizer.Get("Stok Kodu:", "Stock Code:") @Model?.ProductCode
                            </span>
                            @if (!string.IsNullOrEmpty(Model?.CategoryName))
                            {
                                <a href="/Product/Index?categoryId=@Model.CategoryID" class="inline-block px-3 py-1 bg-indigo-50 text-indigo-600 text-xs font-bold rounded-lg tracking-wider uppercase border border-indigo-100 hover:bg-indigo-100 transition-colors">
                                    <i class="fa-solid fa-tags mr-1"></i> @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.CategoryName_EN) ? Model?.CategoryName_EN : Model?.CategoryName)
                                </a>
                            }
                        </div>
                        <h1 class="text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.Name_EN) ? Model?.Name_EN : Model?.Name_TR)</h1>
                        
                        @if (!string.IsNullOrEmpty(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.ShortDescription_EN) ? Model?.ShortDescription_EN : Model?.ShortDescription_TR))
                        {
                            <p class="text-slate-500 text-lg leading-relaxed font-medium">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.ShortDescription_EN) ? Model?.ShortDescription_EN : Model?.ShortDescription_TR)</p>
                        }
                    </div>

                    <!-- Renkler -->
                    <div class="mb-8 p-6 bg-slate-50 rounded-2xl border border-slate-100">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-palette text-indigo-400"></i> @Localizer.Get("Üretim Renkleri", "Production Colors")
                        </h3>
                        <div class="flex flex-wrap gap-3">
                            @if (Model?.Colors != null && Model.Colors.Any())
                            {
                                foreach (var color in Model.Colors)
                                {
                                    <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 rounded-full shadow-sm hover:shadow-md transition-all cursor-pointer">
                                        <span class="w-5 h-5 rounded-full shadow-inner border border-slate-100" style="background-color: @color.ColorHex;"></span>
                                        <span class="text-sm font-bold text-slate-700">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(color.ColorName_EN) ? color.ColorName_EN : color.ColorName)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-sm font-bold text-slate-400 italic">@Localizer.Get("Tüm standart renklerde üretilebilir.", "Can be produced in all standard colors.")</span>
                            }
                        </div>
                    </div>

                    <!-- Teknik Özellikler Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 mb-8">
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-box text-indigo-400 text-2xl mb-3"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Koli Adedi", "Box Quantity")</div>
                            <div class="text-lg font-black text-slate-800">@Model?.BoxCount</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-flask text-indigo-400 text-2xl mb-3"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Hacim", "Volume")</div>
                            <div class="text-lg font-black text-slate-800">@(string.IsNullOrEmpty(Model?.Capacity) ? "-" : Model.Capacity)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-cubes-stacked text-indigo-400 text-2xl mb-3"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Hammadde", "Material")</div>
                            <div class="text-lg font-black text-slate-800">@(string.IsNullOrEmpty(Model?.Material) ? "PP" : Model.Material)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-ruler-combined text-indigo-400 text-2xl mb-3"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Koli Ölçüsü", "Box Size")</div>
                            <div class="text-sm font-black text-slate-800 mt-1.5">@(string.IsNullOrEmpty(Model?.BoxSize) ? "-" : Model.BoxSize)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-weight-hanging text-indigo-400 text-2xl mb-3"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Koli Ağırlığı", "Box Weight")</div>
                            <div class="text-sm font-black text-slate-800 mt-1.5">@(string.IsNullOrEmpty(Model?.BoxWeight) ? "-" : Model.BoxWeight)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center flex flex-col justify-center items-center">
                            @if (Model?.IsDishwasherSafe == true)
                            {
                                <i class="fa-solid fa-soap text-sky-400 text-2xl mb-3"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Bulaşık Makinesi", "Dishwasher Safe")</div>
                                <div class="text-xs font-black text-sky-600 mt-1">@Localizer.Get("Uygun", "Safe")</div>
                            }
                            else
                            {
                                <i class="fa-solid fa-ban text-rose-400 text-2xl mb-3"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Bulaşık Makinesi", "Dishwasher Safe")</div>
                                <div class="text-xs font-black text-rose-500 mt-1">@Localizer.Get("Uygun Değil", "Not Safe")</div>
                            }
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center flex flex-col justify-center items-center">
                            @if (Model?.IsFoodSafe == true)
                            {
                                <i class="fa-solid fa-utensils text-emerald-500 text-2xl mb-3"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Gıda Teması", "Food Contact")</div>
                                <div class="text-xs font-black text-emerald-600 mt-1">@Localizer.Get("Uygun", "Safe")</div>
                            }
                            else
                            {
                                <i class="fa-solid fa-ban text-rose-400 text-2xl mb-3"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">@Localizer.Get("Gıda Teması", "Food Contact")</div>
                                <div class="text-xs font-black text-rose-500 mt-1">@Localizer.Get("Uygun Değil", "Not Safe")</div>
                            }
                        </div>
                    </div>

                    <!-- Aksiyon -->
                    <div class="flex gap-4">
                        <a href="/Contact" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-center py-4 rounded-2xl font-bold text-lg shadow-lg shadow-indigo-600/30 transition-all hover:-translate-y-1 flex items-center justify-center gap-2">
                            <i class="fa-brands fa-whatsapp text-2xl"></i> @Localizer.Get("İletişime Geçin", "Contact Us")
                        </a>
                    </div>
                </div>

            </div>
            
            <!-- Uzun Açıklama -->
            @if (!string.IsNullOrEmpty(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.FullDescription_EN) ? Model?.FullDescription_EN : Model?.FullDescription_TR))
            {
                <div class="mt-16 pt-12 border-t border-slate-100">
                    <h3 class="text-2xl font-black text-slate-800 mb-6 flex items-center gap-3">
                        <i class="fa-solid fa-file-alt text-indigo-500"></i> @Localizer.Get("Ürün Detayları", "Product Details")
                    </h3>
                    <div class="prose prose-slate max-w-none prose-p:text-slate-600 prose-p:leading-relaxed text-lg">
                        @Html.Raw((Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model?.FullDescription_EN) ? Model?.FullDescription_EN : Model?.FullDescription_TR).Replace("\n", "<br/>"))
                    </div>
                </div>
            }
            
        </div>
    </div>
</section>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 z-[100] bg-slate-900/95 backdrop-blur-sm items-center justify-center" onclick="closeLightbox(event)">
    <button class="absolute top-6 right-6 z-50 w-12 h-12 bg-white/10 hover:bg-white/20 rounded-full text-white text-xl flex items-center justify-center transition-colors">
        <i class="fa-solid fa-xmark"></i>
    </button>
    
    <!-- Lightbox Sol Ok -->
    <button onclick="prevImage(event)" class="absolute left-4 lg:left-12 z-50 w-14 h-14 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-colors">
        <i class="fa-solid fa-chevron-left text-2xl"></i>
    </button>

    <img id="lightbox-img" src="" class="max-w-[90vw] max-h-[90vh] object-contain drop-shadow-2xl rounded-2xl" onclick="event.stopPropagation()" />

    <!-- Lightbox Sağ Ok -->
    <button onclick="nextImage(event)" class="absolute right-4 lg:right-12 z-50 w-14 h-14 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-colors">
        <i class="fa-solid fa-chevron-right text-2xl"></i>
    </button>
</div>

@section Scripts {
    <script>
        const images = [];
        let currentIndex = 0;

        document.addEventListener("DOMContentLoaded", () => {
            const thumbs = document.querySelectorAll('.thumb-btn');
            thumbs.forEach(t => images.push(t.getAttribute('data-src')));
        });

        function changeImage(btn, src) {
            currentIndex = images.indexOf(src);
            updateUI(src);
        }

        function updateUI(src) {
            // Aktif butonu değiştir
            document.querySelectorAll('.thumb-btn').forEach(b => {
                if (b.getAttribute('data-src') === src) {
                    b.classList.add('active', 'border-indigo-600', 'opacity-100');
                    b.classList.remove('border-slate-200', 'opacity-70');
                    b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                } else {
                    b.classList.remove('active', 'border-indigo-600', 'opacity-100');
                    b.classList.add('border-slate-200', 'opacity-70');
                }
            });

            // Ana resmi değiştir animasyonla
            const mainImg = document.getElementById('main-image');
            mainImg.style.opacity = '0';
            mainImg.style.transform = 'scale(0.95)';
            
            // Eğer lightbox açıksa onu da güncelle
            const lbImg = document.getElementById('lightbox-img');
            
            setTimeout(() => {
                mainImg.src = src;
                mainImg.style.opacity = '1';
                mainImg.style.transform = 'scale(1)';
                
                if (lbImg) lbImg.src = src;
            }, 300);
        }

        function nextImage(event) {
            event.stopPropagation();
            if (images.length === 0) return;
            currentIndex = (currentIndex + 1) % images.length;
            updateUI(images[currentIndex]);
        }

        function prevImage(event) {
            event.stopPropagation();
            if (images.length === 0) return;
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            updateUI(images[currentIndex]);
        }

        // Lightbox Fonksiyonları
        function openLightbox(src) {
            const lb = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            img.src = src;
            lb.classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox(e) {
            // Eğer tıklanan element lightbox'ın kendisiyse (siyah arka plan) veya çarpıysa kapat
            if (e && e.target.id !== 'lightbox' && e.target.tagName !== 'BUTTON' && e.target.tagName !== 'I') return;
            
            const lb = document.getElementById('lightbox');
            lb.classList.remove('show');
            document.body.style.overflow = 'auto';
        }
        
        // Klavye tuşları
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') nextImage(e);
            if (e.key === 'ArrowLeft') prevImage(e);
        });
    </script>
}









