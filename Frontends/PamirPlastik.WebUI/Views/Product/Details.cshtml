@model PamirPlastik.WebUI.DTOs.ProductDtos.ResultProductDto
@{
    ViewData["Title"] = (Model?.Name_TR ?? "Ürün Detayı") + " - Pamir Plastik";
    ViewData["Description"] = Model?.Description_TR ?? "Pamir Plastik yüksek kaliteli, dayanıklı ve ergonomik ürün detaylarını inceleyin.";
    ViewData["PageName"] = "Ürünler / " + (Model?.Name_TR ?? "Ürün Detayı");
    ViewData["HeaderTitle"] = Model?.Name_TR ?? "Ürün Detayı";
}

<section class="relative z-20 -mt-10 py-16 bg-gradient-to-b from-[#f4f7fa] to-white min-h-screen">
    <!-- Dekoratif Arka Plan Åekilleri -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none opacity-40 z-0">
        <div class="absolute -top-[10%] -right-[5%] w-[500px] h-[500px] bg-pamir-brand/5 rounded-full blur-[120px]"></div>
        <div class="absolute top-[40%] -left-[10%] w-[600px] h-[600px] bg-[#ffda44]/5 rounded-full blur-[150px]"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

            <div class="lg:col-span-6 space-y-8">
                <div class="relative bg-white/60 backdrop-blur-2xl rounded-[3rem] p-10 border border-white/80 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.05)] overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-br from-[#f8fafc] to-[#eef2f6] opacity-80 z-0"></div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-white/40 rounded-full blur-3xl z-0"></div>
                    
                    <img id="main-image" src="@Model?.ImageUrl"
                         alt="@Model?.Name_TR"
                         class="relative z-10 w-full h-[400px] md:h-[500px] object-contain drop-shadow-[0_20px_25px_rgba(0,0,0,0.15)] transition-transform duration-700 ease-out group-hover:scale-[1.03]" />
                </div>

                <div class="flex justify-center gap-4 px-4">
                    <button onclick="changeImage(this.querySelector('img').src)" class="relative w-20 h-20 rounded-2xl bg-white border-2 border-[#ffda44] shadow-[0_8px_20px_-6px_rgba(255,218,68,0.4)] p-1.5 transition-all transform hover:-translate-y-1 hover:shadow-[0_15px_25px_-5px_rgba(255,218,68,0.5)] overflow-hidden ring-4 ring-[#ffda44]/10">
                        <img src="@Model?.ImageUrl" class="w-full h-full object-cover rounded-[0.8rem]" />
                    </button>
                    @if (Model?.Images != null && Model.Images.Any())
                    {
                        foreach (var img in Model.Images)
                        {
                            <button onclick="changeImage(this.querySelector('img').src)" class="w-20 h-20 rounded-2xl bg-white border-2 border-transparent hover:border-[#ffda44] shadow-sm p-1.5 transition-all transform hover:-translate-y-1 opacity-70 hover:opacity-100 hover:shadow-[0_12px_20px_-6px_rgba(255,218,68,0.3)]">
                                <img src="@img.ImageUrl" class="w-full h-full object-cover rounded-[0.8rem]" />
                            </button>
                        }
                    }
                </div>
            </div>

            <div class="lg:col-span-6 space-y-10 pt-4 lg:pt-8">
                <div class="space-y-5">
                    <div class="inline-flex items-center gap-2 text-[10px] font-black text-pamir-brand tracking-[0.3em] uppercase bg-white px-5 py-2 rounded-full shadow-sm border border-blue-50">
                        <span class="relative flex h-2.5 w-2.5">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pamir-brand opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-pamir-brand"></span>
                        </span>
                        Endüstriyel Çözüm
                    </div>
                    
                    <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-black tracking-tighter uppercase leading-[0.95] text-transparent bg-clip-text bg-gradient-to-r from-[#0f172a] via-[#1e293b] to-pamir-brand drop-shadow-sm pb-2">
                        @Model?.Name_TR
                    </h1>
                    
                    <div class="flex flex-wrap items-center gap-3 text-gray-500 font-bold text-xs tracking-widest pt-2">
                        <span class="bg-gray-100 px-3 py-1.5 rounded-lg text-[#0f172a]">KOD: @Model?.ProductCode</span>
                        <div class="w-1.5 h-1.5 bg-gray-300 rounded-full"></div>
                        <span class="text-pamir-brand bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-100">Kategori: @Model?.CategoryName</span>
                    </div>
                </div>

                <div class="p-5 bg-white/70 backdrop-blur-xl rounded-[2rem] border border-white shadow-[0_10px_40px_-10px_rgba(0,0,0,0.03)] space-y-3 transition-all hover:shadow-[0_15px_40px_-10px_rgba(0,0,0,0.06)]">
                    <div class="flex justify-between items-center">
                        <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Mevcut Renkler</span>
                        <div class="h-[1px] flex-grow mx-4 bg-gradient-to-r from-gray-100 to-transparent"></div>
                    </div>
                    <div class="flex flex-wrap gap-2 md:gap-3">
                        @if (Model?.Colors != null && Model.Colors.Any())
                        {
                            foreach (var color in Model.Colors)
                            {
                                <div class="flex items-center gap-2 md:gap-3 group cursor-pointer transition-all hover:bg-gray-50 p-1 md:p-1.5 rounded-xl pr-3 md:pr-4 border border-transparent hover:border-gray-100" title="@color.ColorName">
                                    <div class="w-6 h-6 md:w-8 md:h-8 rounded-lg shadow-sm border border-gray-100/50 group-hover:scale-110 group-hover:shadow-md transition-all duration-300 relative overflow-hidden flex-shrink-0" style="background-color: @color.ColorHex;">
                                        <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent"></div>
                                    </div>
                                    <span class="text-xs md:text-sm font-bold text-gray-700 group-hover:text-pamir-brand transition-colors whitespace-nowrap">@color.ColorName</span>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-xs font-bold text-gray-400 bg-gray-50 px-3 py-1.5 rounded-lg">Renk bilgisi yok</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5">
                    <div class="bg-white/70 backdrop-blur-xl p-7 rounded-[2rem] border border-white shadow-[0_10px_40px_-10px_rgba(0,0,0,0.03)] hover:border-[#ffda44]/40 hover:shadow-[0_15px_40px_-10px_rgba(255,218,68,0.15)] transition-all group">
                        <div class="w-8 h-8 rounded-full bg-blue-50 text-pamir-brand flex items-center justify-center mb-3 group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-colors">
                            <i class="fa-solid fa-box text-xs"></i>
                        </div>
                        <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Koli Adedi</span>
                        <p class="text-2xl font-black text-[#0f172a] mt-1 group-hover:text-pamir-brand transition-colors">@Model?.BoxCount <span class="text-sm text-gray-400 font-bold">Adet</span></p>
                    </div>
                    <div class="bg-white/70 backdrop-blur-xl p-7 rounded-[2rem] border border-white shadow-[0_10px_40px_-10px_rgba(0,0,0,0.03)] hover:border-[#ffda44]/40 hover:shadow-[0_15px_40px_-10px_rgba(255,218,68,0.15)] transition-all group">
                        <div class="w-8 h-8 rounded-full bg-blue-50 text-pamir-brand flex items-center justify-center mb-3 group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-colors">
                            <i class="fa-solid fa-flask text-xs"></i>
                        </div>
                        <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Hacim Kapasitesi</span>
                        <p class="text-2xl font-black text-[#0f172a] mt-1 group-hover:text-pamir-brand transition-colors">@Model?.Capacity</p>
                    </div>
                </div>

                <div class="pt-6 relative">
                    <div class="absolute -inset-2 bg-gradient-to-r from-pamir-brand/20 to-blue-500/20 rounded-[3rem] blur-xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <a href="/Contact" class="group relative w-full flex items-center justify-center gap-5 py-6 bg-[#0f172a] text-white rounded-[2rem] overflow-hidden transition-all shadow-[0_20px_40px_-10px_rgba(15,23,42,0.4)] hover:shadow-[0_25px_50px_-12px_rgba(15,23,42,0.6)] hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-r from-pamir-brand to-[#5c73d1] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="relative z-10 flex items-center gap-4">
                            <div class="w-12 h-12 rounded-2xl bg-[#ffda44] flex items-center justify-center text-[#0f172a] shadow-lg transform group-hover:rotate-[180deg] transition-all duration-700">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                            <span class="font-black text-lg uppercase tracking-widest">Hemen Teklif İste</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="mt-24 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 relative">
            <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-gray-200 to-transparent"></div>
            
            <div class="lg:col-span-7 pt-16 space-y-8">
                <div class="flex items-center gap-4">
                    <div class="w-1.5 h-8 bg-[#ffda44] rounded-full"></div>
                    <h2 class="text-3xl lg:text-4xl font-black text-[#0f172a] tracking-tighter uppercase">Üretim Standartları</h2>
                </div>
                
                <div class="prose prose-lg text-gray-600 font-medium leading-relaxed max-w-none prose-p:mb-6">
                    <p>@Model?.Description_TR</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-12">
                    <div class="group flex items-center gap-5 p-5 bg-white/80 backdrop-blur-sm rounded-[1.5rem] shadow-[0_5px_15px_-5px_rgba(0,0,0,0.05)] border border-white hover:border-[#ffda44]/50 transition-all hover:-translate-y-1">
                        <div class="w-12 h-12 rounded-2xl bg-blue-50/80 text-pamir-brand flex items-center justify-center group-hover:bg-pamir-brand group-hover:text-white transition-colors shadow-sm">
                            <i class="fa-solid fa-sink text-lg"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Makinede Yıkanabilirlik</span>
                            <span class="text-[#0f172a] font-black text-sm">@(Model?.IsDishwasherSafe == true ? "Güvenle Yıkanabilir" : "Elde Yıkama Önerilir")</span>
                        </div>
                    </div>
                    <div class="group flex items-center gap-5 p-5 bg-white/80 backdrop-blur-sm rounded-[1.5rem] shadow-[0_5px_15px_-5px_rgba(0,0,0,0.05)] border border-white hover:border-[#ffda44]/50 transition-all hover:-translate-y-1">
                        <div class="w-12 h-12 rounded-2xl bg-yellow-50/80 text-[#ffda44] flex items-center justify-center group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-colors shadow-sm">
                            <i class="fa-solid fa-utensils text-lg"></i>
                        </div>
                        <div class="flex flex-col">
                            <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Gıda Güvenliği</span>
                            <span class="text-[#0f172a] font-black text-sm">@(Model?.IsFoodSafe == true ? "%100 Uygun" : "Uygun Değildir")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 pt-16">
                <div class="bg-[#0f172a] rounded-[3rem] p-10 lg:p-12 shadow-[0_30px_60px_-15px_rgba(15,23,42,0.5)] space-y-10 relative overflow-hidden text-white border border-gray-800">
                    <!-- Glow effects -->
                    <div class="absolute top-0 right-0 w-64 h-64 bg-[#ffda44]/10 rounded-full blur-[80px]"></div>
                    <div class="absolute bottom-0 left-0 w-48 h-48 bg-pamir-brand/30 rounded-full blur-[60px]"></div>
                    
                    <div class="flex items-center gap-4 relative z-10">
                        <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center border border-white/20 backdrop-blur-md">
                            <i class="fa-solid fa-truck-fast text-[#ffda44]"></i>
                        </div>
                        <h3 class="text-2xl font-black uppercase tracking-tighter">Lojistik Verileri</h3>
                    </div>
                    
                    <div class="space-y-6 relative z-10">
                        <div class="flex items-center justify-between py-4 border-b border-white/10 group">
                            <span class="text-white/40 font-bold uppercase tracking-widest text-xs group-hover:text-white/70 transition-colors">Hammadde</span>
                            <span class="font-black text-lg bg-white/5 px-4 py-1 rounded-lg">@Model?.Material</span>
                        </div>
                        <div class="flex items-center justify-between py-4 border-b border-white/10 group">
                            <span class="text-white/40 font-bold uppercase tracking-widest text-xs group-hover:text-white/70 transition-colors">Koli Ölçüsü</span>
                            <span class="font-black text-lg bg-white/5 px-4 py-1 rounded-lg">@Model?.BoxSize</span>
                        </div>
                        <div class="flex items-center justify-between py-4 border-b border-white/10 group">
                            <span class="text-white/40 font-bold uppercase tracking-widest text-xs group-hover:text-white/70 transition-colors">Koli Ağırlığı</span>
                            <span class="font-black text-lg bg-white/5 px-4 py-1 rounded-lg">@Model?.BoxWeight</span>
                        </div>
                        <div class="flex items-center justify-between pt-4 mt-2 bg-gradient-to-r from-transparent via-[#ffda44]/10 to-transparent p-4 rounded-xl">
                            <span class="text-white/60 font-bold uppercase tracking-widest text-xs">Yükleme Kapasitesi</span>
                            <span class="text-[#ffda44] font-black text-lg uppercase flex items-center gap-2">
                                <span class="relative flex h-3 w-3">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#ffda44] opacity-75"></span>
                                  <span class="relative inline-flex rounded-full h-3 w-3 bg-[#ffda44]"></span>
                                </span>
                                Yüksek
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function changeImage(src) {
            const mainImg = document.getElementById('main-image');
            mainImg.style.opacity = '0';
            mainImg.style.transform = 'translateY(15px)';
            setTimeout(() => {
                mainImg.src = src;
                mainImg.style.opacity = '1';
                mainImg.style.transform = 'translateY(0)';
            }, 300);
        }
    </script>
}

<style>
    #main-image {
        transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    body {
        background-color: #f4f7fa;
    }
</style>
