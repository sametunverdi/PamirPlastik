@model PamirPlastik.WebUI.DTOs.ProductDtos.ResultProductDto
@{
    ViewData["Title"] = "Ürünler / " + (Model?.Name_TR ?? "Ürün Detayı");
    ViewData["Description"] = Model?.Description_TR;
    ViewData["PageName"] = "Ürün Kataloğu";
    ViewData["HeaderTitle"] = Model?.Name_TR ?? "Ürün Detayı";
}

<style>
    body { background-color: #f8fafc; }
    .thumb-btn.active { border-color: #6366f1; opacity: 1; transform: scale(1.05); }
    .thumb-btn { transition: all 0.3s ease; }
</style>

<div class="bg-white border-b border-slate-200 sticky top-[80px] z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <nav class="flex text-sm font-medium text-slate-500" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="hover:text-indigo-600 transition-colors"><i class="fa-solid fa-home mr-2"></i>Ana Sayfa</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <i class="fa-solid fa-chevron-right text-slate-400 text-xs mx-2"></i>
                        <a href="/Product/Index" class="hover:text-indigo-600 transition-colors">Ürünler</a>
                    </div>
                </li>
                @if (!string.IsNullOrEmpty(Model?.CategoryName))
                {
                    <li>
                        <div class="flex items-center">
                            <i class="fa-solid fa-chevron-right text-slate-400 text-xs mx-2"></i>
                            <a href="/Product/Index?categoryId=@Model.CategoryID" class="hover:text-indigo-600 transition-colors">@Model.CategoryName</a>
                        </div>
                    </li>
                }
                <li aria-current="page">
                    <div class="flex items-center">
                        <i class="fa-solid fa-chevron-right text-slate-400 text-xs mx-2"></i>
                        <span class="text-slate-800 font-bold">@Model?.Name_TR</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-[2.5rem] p-6 lg:p-12 shadow-xl shadow-slate-200/50 border border-slate-100">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <!-- Sol Kolon: Galeri -->
                <div class="lg:col-span-5 flex flex-col-reverse lg:flex-row gap-4">
                    <!-- Thumbnail List (Vertical on Desktop, Horizontal on Mobile) -->
                    <div class="flex lg:flex-col gap-3 overflow-x-auto lg:overflow-visible pb-2 lg:pb-0 w-full lg:w-24 flex-shrink-0">
                        @{
                            var coverImg = !string.IsNullOrEmpty(Model?.MainImageUrl) ? Model.MainImageUrl : Model?.ImageUrl;
                        }
                        
                        <button onclick="changeImage(this, '@coverImg')" class="thumb-btn active w-20 h-20 lg:w-24 lg:h-24 rounded-2xl border-2 border-slate-200 p-1 opacity-100 bg-slate-50 flex-shrink-0">
                            <img src="@coverImg" class="w-full h-full object-cover rounded-xl" alt="Kapak" />
                        </button>

                        @if (Model?.Images != null && Model.Images.Any())
                        {
                            foreach (var img in Model.Images)
                            {
                                <button onclick="changeImage(this, '@img.ImageUrl')" class="thumb-btn w-20 h-20 lg:w-24 lg:h-24 rounded-2xl border-2 border-slate-200 p-1 opacity-70 hover:opacity-100 bg-slate-50 flex-shrink-0">
                                    <img src="@img.ImageUrl" class="w-full h-full object-cover rounded-xl" alt="Galeri Resmi" />
                                </button>
                            }
                        }
                    </div>

                    <!-- Büyük Resim -->
                    <div class="flex-grow bg-slate-50 rounded-[2rem] border border-slate-100 p-8 flex items-center justify-center relative group min-h-[400px]">
                        <img id="main-image" src="@coverImg" alt="@Model?.Name_TR" class="w-full max-h-[500px] object-contain transition-transform duration-500 group-hover:scale-105" />
                        
                        @if (Model?.IsFeatured == true)
                        {
                            <span class="absolute top-6 right-6 bg-amber-400 text-amber-900 text-xs font-bold px-4 py-2 rounded-full shadow-lg shadow-amber-400/30 flex items-center gap-2">
                                <i class="fa-solid fa-star"></i> Vitrin
                            </span>
                        }
                    </div>
                </div>

                <!-- Sağ Kolon: Bilgiler -->
                <div class="lg:col-span-7 flex flex-col justify-center">
                    
                    <div class="mb-6">
                        <span class="inline-block px-3 py-1 bg-indigo-50 text-indigo-600 text-xs font-bold rounded-lg mb-4 tracking-wider uppercase border border-indigo-100">
                            Ürün Kodu: @Model?.ProductCode
                        </span>
                        <h1 class="text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">@Model?.Name_TR</h1>
                        <p class="text-slate-500 text-lg leading-relaxed font-medium">@Model?.Description_TR</p>
                    </div>

                    <!-- Renkler -->
                    <div class="mb-8 p-6 bg-slate-50 rounded-2xl border border-slate-100">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">Üretim Renkleri</h3>
                        <div class="flex flex-wrap gap-3">
                            @if (Model?.Colors != null && Model.Colors.Any())
                            {
                                foreach (var color in Model.Colors)
                                {
                                    <div class="flex items-center gap-2 px-3 py-1.5 bg-white border border-slate-200 rounded-full shadow-sm hover:shadow-md transition-all cursor-pointer">
                                        <span class="w-5 h-5 rounded-full shadow-inner border border-slate-100" style="background-color: @color.ColorHex;"></span>
                                        <span class="text-sm font-bold text-slate-700 pr-1">@color.ColorName</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="text-sm font-bold text-slate-400 italic">Tüm standart renklerde üretilebilir.</span>
                            }
                        </div>
                    </div>

                    <!-- Teknik Özellikler Grid -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-box text-indigo-400 text-xl mb-2"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Koli Adedi</div>
                            <div class="text-lg font-black text-slate-800">@Model?.BoxCount</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-flask text-indigo-400 text-xl mb-2"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Hacim</div>
                            <div class="text-lg font-black text-slate-800">@(string.IsNullOrEmpty(Model?.Capacity) ? "-" : Model.Capacity)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-cubes-stacked text-indigo-400 text-xl mb-2"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Hammadde</div>
                            <div class="text-lg font-black text-slate-800">@(string.IsNullOrEmpty(Model?.Material) ? "PP" : Model.Material)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-ruler-combined text-indigo-400 text-xl mb-2"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Koli Ölçüsü</div>
                            <div class="text-sm font-black text-slate-800 mt-1.5">@(string.IsNullOrEmpty(Model?.BoxSize) ? "-" : Model.BoxSize)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center">
                            <i class="fa-solid fa-weight-hanging text-indigo-400 text-xl mb-2"></i>
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Koli Ağırlığı</div>
                            <div class="text-sm font-black text-slate-800 mt-1.5">@(string.IsNullOrEmpty(Model?.BoxWeight) ? "-" : Model.BoxWeight)</div>
                        </div>
                        <div class="bg-white border border-slate-200 p-4 rounded-2xl shadow-sm text-center flex flex-col justify-center items-center">
                            @if (Model?.IsFoodSafe == true)
                            {
                                <i class="fa-solid fa-utensils text-emerald-500 text-xl mb-2"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Gıda Teması</div>
                                <div class="text-xs font-black text-emerald-600 mt-1">Uygun</div>
                            }
                            else
                            {
                                <i class="fa-solid fa-ban text-rose-400 text-xl mb-2"></i>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Gıda Teması</div>
                                <div class="text-xs font-black text-rose-500 mt-1">Uygun Değil</div>
                            }
                        </div>
                    </div>

                    <!-- Aksiyon -->
                    <div class="flex gap-4">
                        <a href="/Contact" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white text-center py-4 rounded-2xl font-bold text-lg shadow-lg shadow-indigo-600/30 transition-all hover:-translate-y-1">
                            Toptan Fiyat Alın
                        </a>
                    </div>
                </div>

            </div>
            
            <!-- Uzun Açıklama -->
            @if (!string.IsNullOrEmpty(Model?.Description_TR))
            {
                <div class="mt-16 pt-12 border-t border-slate-100">
                    <h3 class="text-2xl font-black text-slate-800 mb-6 flex items-center gap-3">
                        <i class="fa-solid fa-file-alt text-indigo-500"></i> Ürün Detayları
                    </h3>
                    <div class="prose prose-slate max-w-none prose-p:text-slate-600 prose-p:leading-relaxed">
                        @Html.Raw(Model.Description_TR.Replace("\n", "<br/>"))
                    </div>
                </div>
            }
            
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function changeImage(btn, src) {
            // Aktif butonu değiştir
            document.querySelectorAll('.thumb-btn').forEach(b => {
                b.classList.remove('active', 'border-indigo-600');
                b.classList.add('border-slate-200', 'opacity-70');
            });
            btn.classList.add('active', 'border-indigo-600');
            btn.classList.remove('border-slate-200', 'opacity-70');

            // Ana resmi değiştir animasyonla
            const mainImg = document.getElementById('main-image');
            mainImg.style.opacity = '0';
            mainImg.style.transform = 'scale(0.95)';
            setTimeout(() => {
                mainImg.src = src;
                mainImg.style.opacity = '1';
                mainImg.style.transform = 'scale(1)';
            }, 300);
        }
    </script>
}
