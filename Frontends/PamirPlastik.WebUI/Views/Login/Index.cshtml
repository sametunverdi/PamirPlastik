@model PamirPlastik.WebUI.DTOs.LoginDtos.CreateLoginDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli Girişi - Pamir Plastik</title>
    <link rel="icon" type="image/png" href="/images/favicon-square.png?v=2">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Outfit', sans-serif; 
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            min-height: 100vh;
        }
        
        /* Dinamik Arka Plan Animasyonu */
        .animated-bg {
            background: linear-gradient(-45deg, #0f172a, #1e3a8a, #082f49, #172554);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -2;
        }

        @@keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Yüzen Işık Hüzmeleri */
        .orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            z-index: -1;
            animation: float 20s infinite ease-in-out alternate;
        }
        .orb-1 {
            width: 300px; height: 300px;
            background: rgba(74, 95, 193, 0.5);
            top: -50px; left: -50px;
        }
        .orb-2 {
            width: 400px; height: 400px;
            background: rgba(56, 189, 248, 0.3);
            bottom: -100px; right: -50px;
            animation-delay: -5s;
        }

        @@keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(30px, 30px) scale(1.1); }
        }

        /* Ana Kart (Cam Efekti) */
        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        /* Input Animasyonları */
        .glass-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            transition: all 0.3s ease;
        }
        .glass-input:focus {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
            box-shadow: 0 0 15px rgba(74, 95, 193, 0.5);
            outline: none;
        }
        .glass-input::placeholder {
            color: rgba(255, 255, 255, 0.4);
        }

        @@media (min-width: 768px) {
            .orb-1 { width: 400px; height: 400px; top: -100px; left: -100px; }
            .orb-2 { width: 500px; height: 500px; bottom: -150px; right: -100px; }
        }
    </style>
</head>
<body class="flex flex-col items-center justify-center text-white py-10 px-4 md:px-0">

    <!-- Arka Plan -->
    <div class="animated-bg"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <!-- İkiye Bölünmüş Tasarım (Mobilde Alt Alta, Masaüstünde Yanyana) -->
    <div class="flex flex-col md:flex-row glass-card rounded-3xl overflow-hidden max-w-4xl w-full shadow-2xl relative z-10 mb-8">
        
        <!-- Sol/Üst Taraf: Marka ve Açıklama -->
        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center items-center text-center relative border-b md:border-b-0 md:border-r border-white/10 bg-white/5">
            <div class="z-10">
                <div class="inline-block p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 mb-6 shadow-lg">
                    <!-- Gerçek Logo Yolu (Beyaz Logo) -->
                    <img src="/images/logo-white.png" alt="Pamir Plastik" class="h-10 md:h-14 lg:h-16 mx-auto object-contain drop-shadow-lg" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3233/3233515.png'">
                </div>
                <h2 class="text-2xl md:text-3xl font-bold mb-3 md:mb-4 tracking-tight drop-shadow-md">Pamir Plastik<br class="md:hidden"> Yönetim Paneli</h2>
                <p class="text-blue-100 text-sm leading-relaxed opacity-90 hidden sm:block drop-shadow-sm">İçeriklerinizi, ürünlerinizi ve müşteri taleplerinizi tek bir noktadan güvenli ve hızlı bir şekilde yönetin.</p>
            </div>
        </div>

        <!-- Sağ/Alt Taraf: Giriş Formu -->
        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center bg-white/5 backdrop-blur-md">
            
            <div class="text-center mb-8">
                <h3 class="text-xl md:text-2xl font-bold text-white drop-shadow-sm">Hoş Geldiniz</h3>
                <p class="text-xs md:text-sm text-blue-200 mt-2 opacity-80">Devam etmek için bilgilerinizi girin.</p>
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="bg-red-500/20 border border-red-500/50 backdrop-blur-sm p-4 mb-6 rounded-xl flex items-center shadow-lg">
                    <svg class="h-5 w-5 text-red-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <p class="text-sm text-red-100 font-medium">@ViewBag.ErrorMessage</p>
                </div>
            }

            <form method="post" action="/Login/Index" class="space-y-5 md:space-y-6">
                <div>
                    <label for="Username" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Kullanıcı Adı</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-blue-300 text-gray-400">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <input type="text" id="Username" name="Username" required class="glass-input block w-full pl-11 pr-4 py-3 md:py-3.5 rounded-xl text-sm" placeholder="Kullanıcı adınızı girin">
                    </div>
                </div>

                <div>
                    <label for="Password" class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-2">Şifre</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none transition-colors group-focus-within:text-blue-300 text-gray-400">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                        <input type="password" id="Password" name="Password" required class="glass-input block w-full pl-11 pr-4 py-3 md:py-3.5 rounded-xl text-sm" placeholder="••••••••">
                    </div>
                </div>

                <div class="flex items-center justify-between mt-3 md:mt-4">
                    <div class="flex items-center">
                        <input id="remember-me" name="remember-me" type="checkbox" class="h-4 w-4 text-blue-500 focus:ring-blue-500 bg-white/10 border-white/20 rounded cursor-pointer">
                        <label for="remember-me" class="ml-2 block text-xs md:text-sm text-gray-300 cursor-pointer">Beni Hatırla</label>
                    </div>
                    <div class="text-xs md:text-sm">
                        <a href="#" class="font-medium text-blue-300 hover:text-white transition duration-150">Şifremi Unuttum?</a>
                    </div>
                </div>

                <div class="pt-2 md:pt-4">
                    <button type="submit" class="w-full flex justify-center py-3.5 md:py-4 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 shadow-[0_0_20px_rgba(79,70,229,0.4)] hover:shadow-[0_0_25px_rgba(79,70,229,0.6)] transform transition-all active:scale-[0.98]">
                        Sisteme Giriş Yap
                    </button>
                </div>
            </form>
            
        </div>
    </div>
    
    <div class="text-center text-xs font-medium text-gray-400 tracking-wider w-full z-10 drop-shadow-md">
        SECURE SYSTEM &copy; @DateTime.Now.Year PAMİR PLASTİK
    </div>

</body>
</html>
