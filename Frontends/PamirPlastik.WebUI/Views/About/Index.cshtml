@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model PamirPlastik.WebUI.DTOs.AboutDtos.ResultAboutDto
@{
    // SEO: Tarayıcı sekmesinde ve Google arama sonuçlarında çıkacak mavi başlık.
        var titleTr = Model?.SeoTitle_TR ?? "Kurumsal | Pamir Plastik - Plastik Enjeksiyon ve Ev Gereçleri Üreticisi";
    var titleEn = Model?.SeoTitle_EN ?? "Corporate | Pamir Plastik - Plastic Injection Manufacturer";
    ViewData["Title"] = Localizer.Get(titleTr, titleEn);

    var descTr = Model?.SeoDescription_TR ?? "2005'ten bugüne plastik enjeksiyon ve kalıp üretiminde uzman Pamir Plastik.";
    var descEn = Model?.SeoDescription_EN ?? "Pamir Plastik, expert in plastic injection and mold production since 2005.";
    ViewData["Description"] = Localizer.Get(descTr, descEn);

    ViewData["PageName"] = Localizer.Get("Kurumsal", "Corporate");
    ViewData["HeaderTitle"] = Localizer.Get("Plastiğe Şekil Veren <br/> <span class='text-[#ffda44]'>Çeyrek Asırlık Tecrübe</span>", "Shaping Plastic <br/> <span class='text-[#ffda44]'>Quarter Century Experience</span>");
}

@await Component.InvokeAsync("_AboutMainComponentPartial")



<section class="py-24 bg-[#0f172a] relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-pamir-brand/10 rounded-full blur-[150px]"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4">
        <div class="text-center mb-20">
            <h3 class="text-[#ffda44] font-black tracking-[0.4em] text-xs uppercase mb-4">@Localizer.Get("Üretimin Kalbi", "Heart of Production")</h3>
            <h4 class="text-3xl md:text-6xl font-black text-white tracking-tighter">@Html.Raw(Localizer.Get("İleri Teknoloji <span class='text-transparent bg-clip-text bg-gradient-to-r from-[#ffda44] to-white'>Entegre Tesisler</span>", "Advanced Technology <span class='text-transparent bg-clip-text bg-gradient-to-r from-[#ffda44] to-white'>Integrated Facilities</span>"))</h4>
        </div>

        @await Component.InvokeAsync("_AboutFeatureComponentPartial")

        @await Component.InvokeAsync("_AboutImageComponentPartial")
    </div>
</section>

@await Component.InvokeAsync("_AboutVisionComponentPartial")

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var swiper = new Swiper(".corporateSwiper", {
                loop: true,
                effect: "fade", // Daha elit bir geçiş için fade
                fadeEffect: {
                    crossFade: true
                },
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
            });
        });
    </script>
}

<style>
    /* Slider noktalarını sarı yapalım kanka */
    .swiper-pagination-bullet {
        background: white !important;
        opacity: 0.5;
    }

    .swiper-pagination-bullet-active {
        background: #ffda44 !important;
        opacity: 1 !important;
        width: 25px !important;
        border-radius: 5px !important;
        transition: all 0.3s ease;
    }
</style>
