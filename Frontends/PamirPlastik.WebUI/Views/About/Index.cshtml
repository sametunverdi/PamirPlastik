@model PamirPlastik.WebUI.DTOs.AboutDtos.ResultAboutDto
@{
    // SEO: Tarayıcı sekmesinde ve Google arama sonuçlarında çıkacak mavi başlık.
    ViewData["Title"] = Model?.SeoTitle_TR ?? "Kurumsal | Pamir Plastik - Plastik Enjeksiyon ve Ev Gereçleri Üreticisi";

    // SEO: Google aramalarında başlığın altındaki açıklama metni.
    ViewData["Description"] = Model?.SeoDescription_TR ?? "2005'ten bugüne plastik enjeksiyon ve kalıp üretiminde uzman Pamir Plastik. İleri teknoloji makine parkuru ve yenilikçi ev gereçleri çözümleri için tıklayın.";

    // BREADCRUMB (Üst Banner) İÇİN GEREKENLER
    ViewData["PageName"] = "Kurumsal";
    ViewData["HeaderTitle"] = "Plastiğe Şekil Veren <br/> <span class='text-[#ffda44]'>Çeyrek Asırlık Tecrübe</span>";
}

@await Component.InvokeAsync("_AboutMainComponentPartial")



<section class="py-24 bg-[#0f172a] relative overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-pamir-brand/10 rounded-full blur-[150px]"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4">
        <div class="text-center mb-20">
            <h3 class="text-[#ffda44] font-black tracking-[0.4em] text-xs uppercase mb-4">Üretimin Kalbi</h3>
            <h4 class="text-3xl md:text-6xl font-black text-white tracking-tighter">İleri Teknoloji <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#ffda44] to-white">Entegre Tesisler</span></h4>
        </div>

        @await Component.InvokeAsync("_AboutFeatureComponentPartial")

        @await Component.InvokeAsync("_AboutImageComponentPartial")
    </div>
</section>

@await Component.InvokeAsync("_AboutVisionComponentPartial")

@await Component.InvokeAsync("_AboutUicCTAComponentPartial")



@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var swiper = new Swiper(".corporateSwiper", {
                loop: true,
                effect: "fade", // Daha elit bir geçiş için fade
                fadeEffect: {
                    crossFade: true
                },
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: ".swiper-pagination",
                    clickable: true,
                },
            });
        });
    </script>
}

<style>
    /* Slider noktalarını sarı yapalım kanka */
    .swiper-pagination-bullet {
        background: white !important;
        opacity: 0.5;
    }

    .swiper-pagination-bullet-active {
        background: #ffda44 !important;
        opacity: 1 !important;
        width: 25px !important;
        border-radius: 5px !important;
        transition: all 0.3s ease;
    }
</style>