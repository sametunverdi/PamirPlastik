@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model List<PamirPlastik.WebUI.DTOs.CategoryDtos.ResultCategoryDto>
@{
    var settings = ViewBag.HomePageSetting as PamirPlastik.WebUI.DTOs.HomePageSettingDtos.ResultHomePageSettingDto;
}

<section id="kategoriler" class="py-24 bg-gray-50 relative border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-[#4A5FC1] font-bold tracking-widest text-sm uppercase mb-3">@((Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(settings?.CatTitleTop_EN) ? settings?.CatTitleTop_EN : settings?.CatTitleTop_TR) ?? (Localizer.CurrentLanguage == "en" ? "Our Production Groups" : "Üretim Gruplarımız"))</h2>
            <h3 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">
                @Html.Raw((Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(settings?.CatTitleMain_EN) ? settings?.CatTitleMain_EN : settings?.CatTitleMain_TR) ?? (Localizer.CurrentLanguage == "en" ? "Wide <span class=\"text-[#4A5FC1]\">Product</span> Range" : "Geniş <span class=\"text-[#4A5FC1]\">Ürün</span> Yelpazesi"))
            </h3>
            <div class="w-20 h-1.5 bg-gradient-to-r from-[#4A5FC1] to-blue-300 mx-auto rounded-full mb-6"></div>
            <p class="text-lg text-gray-500 font-medium leading-relaxed px-4 md:px-0">
                @((Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(settings?.CatDescription_EN) ? settings?.CatDescription_EN : settings?.CatDescription_TR) ?? (Localizer.CurrentLanguage == "en" ? "As Pamir Plastik, with our 25 years of experience, we combine quality with aesthetics in home and kitchen utensils, and produce practical solutions for every need." : "Pamir Plastik olarak 25 yıllık tecrübemizle, ev ve mutfak gereçlerinde kaliteyi estetikle buluşturuyor, her ihtiyaca yönelik pratik çözümler üretiyoruz."))
            </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="group bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-200 hover:shadow-[0_20px_40px_-15px_rgba(74,95,193,0.15)] hover:-translate-y-2 transition-all duration-300 flex flex-col h-full">
                        <div class="relative overflow-hidden aspect-[4/3] bg-gray-100 border-b border-gray-100">
                            <img loading="lazy" src="@item.ImageUrl" alt="@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(item.Name_EN) ? item.Name_EN : item.Name_TR)" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out" />
                        </div>
                        <div class="p-8 flex flex-col flex-grow">
                            <h4 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-[#4A5FC1] transition-colors">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(item.Name_EN) ? item.Name_EN : item.Name_TR)</h4>
                            <p class="text-gray-500 text-sm leading-relaxed mb-6 flex-grow">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(item.Description_EN) ? item.Description_EN : item.Description_TR)</p>
                            <a href="/Product/Index?categoryId=@item.CategoryID" class="mt-auto inline-flex items-center text-[#4A5FC1] font-bold text-sm tracking-wide bg-blue-50/50 py-2.5 px-4 rounded-xl group/btn hover:bg-[#4A5FC1] hover:text-white transition-colors w-fit">
                                @Localizer.Get("Tüm Ürünleri Gör", "See All Products")
                                <svg class="w-4 h-4 ml-2 group-hover/btn:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-3 text-center py-16 text-gray-400">
                    <p>@Localizer.Get("Henüz kategori eklenmemiş.", "No categories added yet.")</p>
                </div>
            }
        </div>
    </div>
</section>
