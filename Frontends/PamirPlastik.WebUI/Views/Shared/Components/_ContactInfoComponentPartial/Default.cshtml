@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model PamirPlastik.WebUI.DTOs.ContactDtos.ResultContactDto

<div class="space-y-3 px-2 text-center lg:text-left">
    <h2 class="text-2xl font-black text-[#0f172a] tracking-tight uppercase">
        @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Title_EN) ? Model.Title_EN : Model.Title_TR)
    </h2>
    <p class="text-gray-500 text-sm font-medium leading-relaxed">
        @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Description_EN) ? Model.Description_EN : Model.Description_TR)
    </p>
</div>

<div class="space-y-5">
    <div class="group flex items-center gap-6 p-7 bg-white rounded-[2.5rem] border border-gray-100 shadow-sm transition-all hover:border-[#ffda44]/50 hover:shadow-xl">
        <div class="w-14 h-14 rounded-2xl bg-blue-50 text-pamir-brand flex items-center justify-center group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all duration-500">
            <i class="fa-solid fa-phone-volume text-2xl"></i>
        </div>
        <div>
            <span class="text-[9px] font-black text-gray-300 uppercase tracking-widest">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.PhoneTitle_EN) ? Model.PhoneTitle_EN : Model.PhoneTitle_TR)</span>
            <p class="text-lg font-black text-[#0f172a]">@Model.Phone</p>
            <p class="text-[10px] text-gray-400 font-bold mt-1 uppercase tracking-tighter">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.PhoneDescription_EN) ? Model.PhoneDescription_EN : Model.PhoneDescription_TR)</p>
        </div>
    </div>

    @* E-Posta Bölümü *@
    <div class="group flex items-center gap-6 p-7 bg-white rounded-[2.5rem] border border-[#ffda44]/20 shadow-sm transition-all hover:border-pamir-brand hover:shadow-xl">
        <div class="w-14 h-14 rounded-2xl bg-yellow-50 text-[#ffda44] flex items-center justify-center group-hover:bg-pamir-brand group-hover:text-white transition-all duration-500">
            <i class="fa-solid fa-envelope-open-text text-2xl"></i>
        </div>
        <div>
            <span class="text-[9px] font-black text-gray-300 uppercase tracking-widest">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.EmailTitle_EN) ? Model.EmailTitle_EN : Model.EmailTitle_TR)</span>
            <p class="text-lg font-black text-[#0f172a]">@Model.Email</p>
            <p class="text-[10px] text-gray-400 font-bold mt-1 uppercase tracking-tighter">@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.EmailDescription_EN) ? Model.EmailDescription_EN : Model.EmailDescription_TR)</p>
        </div>
    </div>
</div>