@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
<section class="py-24 relative overflow-hidden" style="background: linear-gradient(to right, #0f172a, #4A5FC1);">
    <div class="absolute top-0 right-0 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10"></div>
    <div class="max-w-5xl mx-auto px-4 text-center relative z-10">
        <h4 class="text-white text-4xl md:text-6xl font-black tracking-tighter mb-8">@Html.Raw(Localizer.Get("Bu Güçlü Hikayenin <br /> <span class='text-[#ffda44]'>Parçası Olun.</span>", "Be a Part of <br /> <span class='text-[#ffda44]'>This Strong Story.</span>"))</h4>
        <p class="text-blue-100 text-lg mb-12 font-medium opacity-80">@Localizer.Get("Distribütörlük ve projeleriniz için global çözüm ortağınız olmaya hazırız.", "We are ready to be your global solution partner for distributorship and projects.")</p>
        <div class="flex flex-col sm:flex-row justify-center gap-6">
            <a href="/Contact" class="px-12 py-5 bg-[#ffda44] text-[#0f172a] font-black rounded-2xl shadow-2xl shadow-yellow-500/20 hover:scale-105 transition-all">@Localizer.Get("İletişime Geçin", "Contact Us")</a>
            <a href="/Products" class="px-12 py-5 bg-white/10 text-white border border-white/20 backdrop-blur-md font-black rounded-2xl hover:bg-white/20 transition-all">@Localizer.Get("Ürünlerimizi Keşfedin", "Discover Our Products")</a>
        </div>
    </div>
</section>
