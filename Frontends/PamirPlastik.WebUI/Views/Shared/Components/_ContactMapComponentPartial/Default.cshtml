@model PamirPlastik.WebUI.DTOs.ContactDtos.ResultContactDto

<div class="mt-20 relative rounded-[3rem] overflow-hidden border-4 border-white shadow-lg">

    @if (Model.MapLocation != null && Model.MapLocation.StartsWith("<iframe"))
    {
        <div class="w-full h-[400px] [&~iframe]:w-full [&~iframe]:h-full [&~iframe]:border-0">
            @Html.Raw(Model.MapLocation)
        </div>
    }
    else
    {
        <iframe src="@Model.MapLocation"
                class="w-full h-[400px]"
                style="border:0;"
                allowfullscreen=""
                loading="lazy">
        </iframe>
    }

    <div class="absolute bottom-6 left-6 z-10 hidden md:block">
        <div class="bg-[#0f172a] text-white p-7 rounded-[2rem] shadow-2xl border border-white/5">
            <span class="text-[#ffda44] font-black text-[9px] tracking-widest uppercase block mb-1">
                @Model.MapTitle_TR
            </span>
            <p class="font-bold text-xs leading-relaxed opacity-90 text-white/80">
                @Model.Address_TR
            </p>
        </div>
    </div>
</div>