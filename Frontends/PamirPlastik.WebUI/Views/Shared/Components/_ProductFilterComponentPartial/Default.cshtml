@model List<PamirPlastik.WebUI.DTOs.CategoryDtos.ResultCategoryDto>

<aside id="filter-sidebar" class="fixed inset-0 z-[60] lg:relative lg:z-0 lg:block lg:w-1/4 transform -translate-x-full lg:translate-x-0 transition-transform duration-500 ease-in-out">

    <div id="filter-overlay" class="absolute inset-0 bg-[#0f172a]/60 backdrop-blur-sm lg:hidden"></div>

    <div class="relative w-[85%] max-w-xs h-full lg:w-full bg-white lg:bg-transparent shadow-2xl lg:shadow-none lg:sticky lg:top-32 overflow-y-auto lg:overflow-visible flex flex-col">

        <div class="flex lg:hidden items-center justify-between p-6 border-b border-gray-100">
            <span class="text-xl font-black text-pamir-brand tracking-tighter uppercase">Filtrele</span>
            <button id="close-filter-btn" class="p-2 bg-gray-50 rounded-xl text-gray-400">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="p-6 lg:p-0">
            <div class="bg-white rounded-[2.5rem] lg:rounded-[2rem] p-8 shadow-sm border border-gray-100">

                <div class="mb-6 relative">
                    <input type="text" placeholder="PMR Kod veya Ürün Ara..." class="w-full bg-gray-50 border border-gray-100 rounded-xl py-3 px-4 text-sm font-medium text-gray-700 placeholder-gray-400 focus:outline-none focus:border-pamir-brand focus:ring-1 focus:ring-pamir-brand transition-all">
                    <svg class="absolute right-4 top-3.5 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <h3 class="text-lg font-black text-[#0f172a] mb-6 uppercase tracking-tighter border-b border-gray-50 pb-4">Kategoriler</h3>

                <div class="space-y-2">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <a href="/Product/Index?categoryId=@item.CategoryID" class="flex items-center justify-between py-3 px-4 rounded-xl font-bold text-gray-500 hover:bg-gray-50 hover:text-pamir-brand transition-all group">
                                <span>@item.Name_TR</span>
                                <span class="text-[10px] bg-gray-100 px-2 py-1 rounded-md group-hover:bg-[#ffda44] group-hover:text-[#0f172a]">@item.ProductCount</span>
                            </a>
                        }
                    }
                </div>

                <div class="mt-10 p-6 bg-[#0f172a] rounded-2xl relative overflow-hidden group">
                    <div class="relative z-10">
                        <h4 class="text-white font-bold text-sm mb-2">Özel Fiyat Teklifi</h4>
                        <p class="text-white/40 text-[10px] mb-4 uppercase font-black">Toptan alımlar için</p>
                        <a href="/Contact" class="block w-full text-center py-3 bg-[#ffda44] text-[#0f172a] rounded-xl font-black text-xs hover:scale-105 transition-all">Teklif Al</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</aside>