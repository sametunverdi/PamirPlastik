@model List<PamirPlastik.WebUI.DTOs.SocialMediaDtos.ResultSocialMediaDto>
@{
    var contact = ViewBag.Contact as PamirPlastik.WebUI.DTOs.ContactDtos.ResultContactDto;
}

<div class="bg-gradient-to-r from-[#8ba1f0] to-[#4A5FC1] text-white text-[10px] sm:text-xs font-medium py-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">

        <div class="flex items-center space-x-3 sm:space-x-6">
            <a href="tel:@(contact?.Phone?.Replace(" ", ""))" class="flex items-center gap-1.5 hover:text-blue-200 transition-colors whitespace-nowrap">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                <span>@(contact?.Phone ?? "+90 212 555 01 23")</span>
            </a>
            <a href="mailto:@(contact?.Email)" class="hidden sm:flex items-center gap-1.5 hover:text-blue-200 transition-colors whitespace-nowrap">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                <span>@(contact?.Email ?? "info@pamirplastik.com")</span>
            </a>
        </div>

        <div class="flex items-center space-x-3">
            <span class="hidden md:inline text-white/60">Bizi Takip Edin:</span>
            <div class="flex items-center space-x-3">
                @if(Model != null)
                {
                    foreach (var item in Model)
                    {
                        <a href="@item.Url" class="hover:text-blue-200 transition-all hover:scale-110" target="_blank">
                            <i class="@item.IconClass"></i>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>