@model List<PamirPlastik.WebUI.DTOs.AboutDtos.ResultAboutFeatureDto>

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    @if (Model != null && Model.Count > 0)
    {
        @foreach (var item in Model)
        {
            <div class="group relative p-1 bg-white/5 rounded-[2.5rem] border border-white/10 hover:border-[#ffda44]/50 transition-all duration-500">
                <div class="bg-[#1e293b] rounded-[2.3rem] p-10 h-full">

                    @* Burası 01, 02 gibi numara veya ikon alanı *@
                    <span class="text-6xl font-black text-white/5 block mb-6 group-hover:text-[#ffda44]/10 transition-colors">
                        @item.ValueOrIcon
                    </span>

                    @* Dinamik Başlık - SEO İçin Önemli *@
                    <h5 class="text-[#ffda44] font-black text-xl mb-4 uppercase">
                        @item.Title_TR
                    </h5>

                    @* Dinamik Açıklama *@
                    <p class="text-gray-400 text-sm leading-relaxed">
                        @item.Description_TR
                    </p>
                </div>
            </div>
        }
    }
</div>