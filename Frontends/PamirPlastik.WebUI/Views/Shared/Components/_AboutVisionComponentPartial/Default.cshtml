@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model PamirPlastik.WebUI.DTOs.AboutDtos.ResultAboutDto

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-20">

            @* Vizyon Bölümü *@
            <div class="relative pl-12 border-l-4 border-[#ffda44]">
                <h3 class="text-xs font-black text-pamir-brand uppercase tracking-[0.5em] mb-6">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.VisionTitle_EN) ? Model.VisionTitle_EN : Model.VisionTitle_TR)
                </h3>
                <p class="text-3xl md:text-4xl font-black text-[#0f172a] leading-tight tracking-tighter">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.VisionDescription_EN) ? Model.VisionDescription_EN : Model.VisionDescription_TR)
                </p>
                <p class="mt-6 text-gray-500 font-medium">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Description1_EN) ? Model.Description1_EN : Model.Description1_TR)
                </p>
            </div>

            @* Misyon Bölümü *@
            <div class="relative pl-12 border-l-4 border-gray-100">
                <h3 class="text-xs font-black text-pamir-brand uppercase tracking-[0.5em] mb-6">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.MissionTitle_EN) ? Model.MissionTitle_EN : Model.MissionTitle_TR)
                </h3>
                <p class="text-3xl md:text-4xl font-black text-[#0f172a] leading-tight tracking-tighter">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.MissionDescription_EN) ? Model.MissionDescription_EN : Model.MissionDescription_TR)
                </p>
                <p class="mt-6 text-gray-500 font-medium">
                    @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Description2_EN) ? Model.Description2_EN : Model.Description2_TR)
                </p>
            </div>

        </div>
    </div>
</section>
