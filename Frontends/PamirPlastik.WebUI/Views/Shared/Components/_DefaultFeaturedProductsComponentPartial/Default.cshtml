@model List<PamirPlastik.WebUI.DTOs.ProductDtos.ResultProductDto>
@{
    var settings = ViewBag.HomePageSetting as PamirPlastik.WebUI.DTOs.HomePageSettingDtos.ResultHomePageSettingDto;
}

<section id="yildiz-urunler" class="py-24 overflow-hidden relative" style="background: linear-gradient(135deg, #f0f9f4 0%, #e8f5e9 100%); border-y: 1px solid #e1eee1;">
    <div class="absolute inset-0 z-0">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-white rounded-full filter blur-[120px] opacity-40"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div class="max-w-2xl">
                <h2 class="text-green-600 font-bold tracking-widest text-sm uppercase mb-3">@(settings?.FeatTitleTop_TR ?? "Sürdürülebilir Kalite")</h2>
                <h3 class="text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
                    @Html.Raw(settings?.FeatTitleMain_TR ?? "Vitrindeki <span class=\"text-green-600\">Yıldız</span> Ürünler")
                </h3>
                <div class="w-20 h-1.5 bg-green-200 mt-4 rounded-full shadow-sm"></div>
            </div>
            <div class="flex gap-3">
                <button class="swiper-prev-btn w-14 h-14 rounded-2xl border border-green-100 bg-white/50 backdrop-blur-sm flex items-center justify-center text-green-700 hover:bg-green-600 hover:text-white hover:border-green-600 transition-all duration-300 group">
                    <svg class="w-6 h-6 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                <button class="swiper-next-btn w-14 h-14 rounded-2xl border border-green-100 bg-white/50 backdrop-blur-sm flex items-center justify-center text-green-700 hover:bg-green-600 hover:text-white hover:border-green-600 transition-all duration-300 group">
                    <svg class="w-6 h-6 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </div>
        <div class="swiper product-swiper !overflow-visible">
            <div class="swiper-wrapper">
                @foreach (var item in Model)
                {
                    <div class="swiper-slide h-auto">
                        <div class="group bg-white rounded-[2.5rem] border border-gray-100 p-6 shadow-sm hover:shadow-[0_20px_50px_-10px_rgba(72,187,120,0.15)] hover:-translate-y-2 transition-all duration-500 h-full flex flex-col">
                            <div class="relative aspect-square rounded-[2rem] overflow-hidden bg-gray-50 mb-7 border border-gray-100">
                                @if (item.Status)
                                {
                                    <span class="absolute top-5 left-5 z-10 bg-green-100 text-green-800 text-[11px] font-black px-4 py-2 rounded-full uppercase tracking-widest shadow-inner">ÖNE ÇIKAN</span>
                                }
                                <img src="@item.ImageUrl" alt="@item.Name_TR" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-in-out" />
                            </div>
                            <div class="px-1 flex-grow">
                                <h4 class="text-2xl font-black text-gray-950 mb-3 group-hover:text-green-700 transition-colors tracking-tight">@item.Name_TR</h4>
                                <p class="text-gray-600 text-sm leading-relaxed mb-8">@item.Description_TR</p>
                            </div>
                            <a href="/Product/Details?id=@item.ProductID" class="w-full py-4 bg-green-50 text-green-700 font-bold rounded-2xl text-center group-hover:bg-green-600 group-hover:text-white group-hover:shadow-lg group-hover:shadow-green-100 transition-all duration-300">
                                Detayları İncele
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>


