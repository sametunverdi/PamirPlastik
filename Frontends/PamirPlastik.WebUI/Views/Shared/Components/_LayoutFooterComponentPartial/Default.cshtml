@model List<PamirPlastik.WebUI.DTOs.SocialMediaDtos.ResultSocialMediaDto>
@{
    var contact = ViewBag.Contact as PamirPlastik.WebUI.DTOs.ContactDtos.ResultContactDto;
}

<footer class="relative overflow-hidden text-white pt-24 pb-12 mt-auto" style="background: linear-gradient(135deg, #8ba1f0 0%, #4A5FC1 40%, #354899 100%);">

    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 left-[-10%] w-[500px] h-[500px] bg-white/10 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-black/20 rounded-full blur-[80px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-20">

            <div class="space-y-8 text-left">
                <a href="/" class="flex flex-col items-start group">
                    <span class="text-4xl font-black text-white tracking-tighter leading-none transition-transform group-hover:scale-105">PAMİR</span>
                    <span class="text-[11px] font-bold text-blue-100 tracking-[0.4em] uppercase opacity-90">Plastik</span>
                </a>
                <p class="text-blue-50/90 text-sm leading-relaxed max-w-xs font-medium">
                    @(contact?.Title_TR ?? "25 yıllık üretim gücümüzle, yarının dünyası için sürdürülebilir plastik çözümleri üretiyoruz.")
                </p>

                <div class="flex gap-4">
                    @if(Model != null)
                    {
                        foreach (var item in Model.Take(4))
                        {
                            <a href="@item.Url" class="w-12 h-12 border border-white/20 text-white rounded-full flex items-center justify-center shadow-lg hover:border-[#ffda44] hover:text-[#ffda44] hover:-translate-y-1 transition-all duration-300 group" target="_blank">
                                <i class="@item.IconClass text-xl"></i>
                            </a>
                        }
                    }
                </div>
            </div>

            <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">Kurumsal<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <ul class="space-y-4 font-bold text-blue-50/80 text-sm">
                    <li><a href="/About/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>Hakkımızda</a></li>
                    <li><a href="/Fair/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>Fuarlarımız</a></li>
                    <li><a href="/Contact/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>İletişim</a></li>
                </ul>
            </div>

            <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">Ürün Grupları<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <ul class="space-y-4 font-bold text-blue-50/80 text-sm">
                    <li><a href="/Product/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>Mutfak Gereçleri</a></li>
                    <li><a href="/Product/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>Banyo Ekipmanları</a></li>
                    <li><a href="/Product/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>Bahçe & Balkon</a></li>
                </ul>
            </div>

            <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">Bize Ulaşın<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <div class="space-y-6">
                    <div class="flex items-center gap-4 group cursor-pointer">
                        <div class="w-16 h-16 bg-[#ffda44] text-[#0f172a] rounded-[2rem] flex flex-shrink-0 items-center justify-center shadow-[0_15px_30px_-10px_rgba(255,218,68,0.4)] group-hover:scale-105 transition-all">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <p class="text-white text-sm font-bold opacity-90 group-hover:text-[#ffda44] transition-colors">@(contact?.Address_TR ?? "Esenyurt / İstanbul, Türkiye")</p>
                    </div>
                    <div class="flex items-center gap-4 group cursor-pointer">
                        <div class="w-16 h-16 bg-[#ffda44] text-[#0f172a] rounded-[2rem] flex flex-shrink-0 items-center justify-center shadow-[0_15px_30px_-10px_rgba(255,218,68,0.4)] group-hover:scale-105 transition-all">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </div>
                        <p class="text-white text-sm font-bold opacity-90 group-hover:text-[#ffda44] transition-colors">@(contact?.Email ?? "info@pamirplastik.com")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-8 border-t border-white/20 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-blue-100/60 text-[11px] font-black uppercase tracking-[0.2em] italic">
                © @DateTime.Now.Year PAMİR PLASTİK. TÜM HAKLARI SAKLIDIR.
            </p>
            <div class="flex gap-8 text-[11px] font-black text-blue-100/60 uppercase tracking-[0.2em]">
                <a href="#" class="hover:text-[#ffda44] transition-colors">KVKK</a>
                <a href="#" class="hover:text-[#ffda44] transition-colors">Çerezler</a>
                <a href="https://sametaku.com" target="_blank" class="text-white/40 hover:text-[#ffda44] transition-colors">Designed by AKU</a>
            </div>
        </div>
    </div>
</footer>