@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model List<PamirPlastik.WebUI.DTOs.SocialMediaDtos.ResultSocialMediaDto>
@{
    var contact = ViewBag.Contact as PamirPlastik.WebUI.DTOs.ContactDtos.ResultContactDto;
}

<footer class="relative overflow-hidden text-white pt-24 pb-12 mt-auto" style="background: linear-gradient(135deg, #8ba1f0 0%, #4A5FC1 40%, #354899 100%);">

    <div class="absolute inset-0 z-0">
        <div class="absolute top-0 left-[-10%] w-[500px] h-[500px] bg-white/10 rounded-full blur-[100px]"></div>
        <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-black/20 rounded-full blur-[80px]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-16 mb-20">

            <div class="space-y-8 text-left">
                <a href="/" class="flex flex-col items-start group">
                    <img src="/images/logo-white.png" alt="Pamir Plastik" class="h-28 w-auto transition-transform group-hover:scale-105" />
                </a>
                <p class="text-blue-50/90 text-sm leading-relaxed max-w-xs font-medium">@Localizer.Get("İnovatif ve sürdürülebilir plastik çözümleriyle 25 yıldır sektörde öncü. Geleceği şekillendiren kalitemizle global pazarlara ulaşıyoruz.", "Leading the industry for 25 years with innovative and sustainable plastic solutions. Reaching global markets with our future-shaping quality.")</p>

                <div class="flex gap-4">
                    @if(Model != null)
                    {
                        foreach (var item in Model.Take(4))
                        {
                            <a href="@item.Url" class="w-12 h-12 border border-white/20 text-white rounded-full flex items-center justify-center shadow-lg hover:border-[#ffda44] hover:text-[#ffda44] hover:-translate-y-1 transition-all duration-300 group" target="_blank">
                                <i class="@item.IconClass text-xl"></i>
                            </a>
                        }
                    }
                </div>
            </div>

                        <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">@Localizer.Get("Sayfalar", "Pages")<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <ul class="space-y-4 font-bold text-blue-50/80 text-sm">
                    <li><a href="/About/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("Hakkımızda", "About Us")</a></li>
                    <li><a href="/Product/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("Tüm Ürünler", "All Products")</a></li>
                    <li><a href="/Category/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("Kategoriler", "Categories")</a></li>
                    <li><a href="/Fair/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("Fuarlarımız", "Fairs")</a></li>
                    <li><a href="/Contact/Index/" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("İletişim", "Contact")</a></li>
                    <li><a href="/Contact/Index?openJobModal=true" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("İş Başvurusu", "Job Application")</a></li>
                    <li><a href="/Home/Privacy" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@Localizer.Get("Gizlilik Politikası", "Privacy Policy")</a></li>
                </ul>
            </div>

                        <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">@Localizer.Get("Ürün Grupları", "Product Groups")<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <ul class="space-y-4 font-bold text-blue-50/80 text-sm">
                    @if (ViewBag.FooterCategories != null)
                    {
                        foreach (var cat in ViewBag.FooterCategories)
                        {
                            <li><a href="/Category/Detail/@cat.CategoryID" class="hover:text-[#ffda44] transition-all flex items-center gap-2 group"><span class="w-1.5 h-1.5 bg-[#ffda44] rounded-full opacity-0 group-hover:opacity-100 transition-all"></span>@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(cat.Name_EN) ? cat.Name_EN : cat.Name_TR)</a></li>
                        }
                    }
                </ul>
            </div>

            <div class="text-left">
                <h4 class="text-white font-black text-lg mb-8 relative inline-block">@Localizer.Get("Bize Ulaşın", "Contact Us")<span class="absolute -bottom-2 left-0 w-8 h-1 bg-[#ffda44] rounded-full"></span></h4>
                <div class="space-y-6">
                    <div class="flex items-center gap-4 group cursor-pointer">
                        <div class="w-16 h-16 bg-[#ffda44] text-[#0f172a] rounded-[2rem] flex flex-shrink-0 items-center justify-center shadow-[0_15px_30px_-10px_rgba(255,218,68,0.4)] group-hover:scale-105 transition-all">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <p class="text-white text-sm font-bold opacity-90 group-hover:text-[#ffda44] transition-colors">@(Localizer.CurrentLanguage == "en" ? (!string.IsNullOrWhiteSpace(contact?.Address_EN) ? contact?.Address_EN : "Esenyurt / Istanbul, Turkey") : (!string.IsNullOrWhiteSpace(contact?.Address_TR) ? contact?.Address_TR : "Esenyurt / İstanbul, Türkiye"))</p>
                    </div>
                    <div class="flex items-center gap-4 group cursor-pointer">
                        <div class="w-16 h-16 bg-[#ffda44] text-[#0f172a] rounded-[2rem] flex flex-shrink-0 items-center justify-center shadow-[0_15px_30px_-10px_rgba(255,218,68,0.4)] group-hover:scale-105 transition-all">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </div>
                        <p class="text-white text-sm font-bold opacity-90 group-hover:text-[#ffda44] transition-colors">@(contact?.Email ?? "info@pamirplastik.com")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="pt-8 border-t border-white/20 flex flex-col md:flex-row justify-between items-center gap-6">
            <p class="text-blue-100/60 text-[11px] font-black uppercase tracking-[0.2em] italic">
                © @DateTime.Now.Year PAMİR PLASTİK. @Localizer.Get("TÜM HAKLARI SAKLIDIR.", "ALL RIGHTS RESERVED.")
            </p>
            <div class="flex gap-8 text-[11px] font-black text-blue-100/60 uppercase tracking-[0.2em]">
                <button onclick="document.getElementById('kvkkModal').classList.remove('hidden')" class="hover:text-[#ffda44] transition-colors outline-none cursor-pointer">@Localizer.Get("KVKK", "Privacy Policy")</button>
                <button onclick="document.getElementById('cookieModal').classList.remove('hidden')" class="hover:text-[#ffda44] transition-colors outline-none cursor-pointer">@Localizer.Get("Çerezler", "Cookies")</button>
                
            </div>
        </div>
    </div>
</footer>
<!-- ⚡ AKU CODE Özel Geliştirici Şeridi (The Very Bottom) ⚡ -->
@{
    var dev = ViewBag.DeveloperSetting as PamirPlastik.WebUI.DTOs.DeveloperSettingDtos.ResultDeveloperSettingDto;
    var devText = dev?.SignatureText ?? "Bu web projesi gururla";
    var devName = dev?.DeveloperName ?? "AKU CODE";
    var devUrl = dev?.DeveloperUrl ?? "https://sametaku.com";
}
<div class="bg-gradient-to-r from-[#050505] via-[#2a0404] to-[#050505] border-t border-[#dc2626]/30 py-3 relative overflow-hidden">
    <!-- Subtle Red Glow -->
    <div class="absolute inset-0 flex justify-center pointer-events-none">
        <div class="w-[300px] h-full bg-[#dc2626]/20 blur-xl"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-center gap-3 relative z-10 text-center">
        <span class="text-gray-400 text-xs font-medium tracking-wide">
            @devText
        </span>
        
        <a href="@devUrl" target="_blank" title="Web Tasarım & Yazılım: @devName" class="group flex items-center gap-2 bg-black hover:bg-[#dc2626] px-3 py-1 rounded-full border border-[#dc2626]/50 hover:border-[#dc2626] shadow-[0_0_10px_rgba(220,38,38,0.3)] hover:shadow-[0_0_20px_rgba(220,38,38,0.6)] transition-all duration-500">
            <i class="fa-solid fa-fire text-[10px] text-[#dc2626] group-hover:text-white transition-colors"></i>
            <span class="text-[10px] font-black text-white tracking-[0.2em] uppercase transition-colors">@devName</span>
        </a>
        
        <span class="text-gray-400 text-xs font-medium tracking-wide">
            taraf&#305;ndan tasarlanm&#305;&#351; ve kodlanm&#305;&#351;t&#305;r.
        </span>
    </div>
</div>

<!-- KVKK Modal -->
<div id="kvkkModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/60 backdrop-blur-sm transition-all">
    <div class="bg-white text-slate-800 w-[90%] max-w-2xl max-h-[80vh] rounded-3xl shadow-2xl overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
            <h3 class="font-bold text-lg text-pamir-brand">KVKK Aydınlatma Metni</h3>
            <button onclick="document.getElementById('kvkkModal').classList.add('hidden')" class="text-slate-400 hover:text-red-500 transition-colors">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        <div class="p-6 overflow-y-auto text-sm text-slate-600 space-y-4">
            <p><strong>Değerli Ziyaretçimiz,</strong></p>
            <p>Pamir Plastik olarak kişisel verilerinizin güvenliğine en üst düzeyde önem vermekteyiz. 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") uyarınca, web sitemiz üzerinden paylaştığınız kişisel verileriniz, veri sorumlusu sıfatıyla Pamir Plastik tarafından işlenmektedir.</p>
            <p><strong>1. Kişisel Verilerin Hangi Amaçla İşleneceği</strong></p>
            <p>Toplanan kişisel verileriniz; şirketimiz tarafından sunulan ürün ve hizmetlerden sizleri faydalandırmak, iletişim taleplerinize yanıt vermek, iş başvurularınızı değerlendirmek ve ticari faaliyetlerimizi sürdürmek amaçlarıyla işlenmektedir.</p>
            <p><strong>2. İşlenen Kişisel Verilerin Kimlere ve Hangi Amaçla Aktarılabileceği</strong></p>
            <p>Kişisel verileriniz, kanuni yükümlülüklerimizin yerine getirilmesi amacıyla yetkili kamu kurumları ve özel kişilerle, KVKK'nın 8. ve 9. maddelerinde belirtilen şartlar dâhilinde paylaşılabilecektir.</p>
            <p><strong>3. Veri Sahibinin Hakları</strong></p>
            <p>KVKK'nın 11. maddesi uyarınca; kişisel verilerinizin işlenip işlenmediğini öğrenme, işlenmişse buna ilişkin bilgi talep etme, eksik veya yanlış işlenmişse düzeltilmesini isteme haklarına sahipsiniz.</p>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end">
            <button onclick="document.getElementById('kvkkModal').classList.add('hidden')" class="px-6 py-2 bg-pamir-brand text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors">Okudum, Anladım</button>
        </div>
    </div>
</div>

<!-- Cookie Modal -->
<div id="cookieModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/60 backdrop-blur-sm transition-all">
    <div class="bg-white text-slate-800 w-[90%] max-w-2xl max-h-[80vh] rounded-3xl shadow-2xl overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
            <h3 class="font-bold text-lg text-pamir-brand">Çerez (Cookie) Politikası</h3>
            <button onclick="document.getElementById('cookieModal').classList.add('hidden')" class="text-slate-400 hover:text-red-500 transition-colors">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        <div class="p-6 overflow-y-auto text-sm text-slate-600 space-y-4">
            <p><strong>Çerez Politikamız</strong></p>
            <p>Pamir Plastik web sitesi (www.pamirplastik.com) olarak, ziyaretçilerimize daha iyi bir kullanıcı deneyimi sunmak, site trafiğimizi analiz etmek ve içeriğimizi kişiselleştirmek amacıyla çerezler (cookies) kullanmaktayız.</p>
            <p><strong>Çerez (Cookie) Nedir?</strong></p>
            <p>Çerezler, bir web sitesini ziyaret ettiğinizde tarayıcınız aracılığıyla cihazınıza depolanan küçük metin dosyalarıdır. Bu dosyalar, sitemizin sizin tercihlerinizi hatırlamasını sağlar.</p>
            <p><strong>Hangi Çerezleri Kullanıyoruz?</strong></p>
            <ul class="list-disc pl-5 space-y-2">
                <li><strong>Zorunlu Çerezler:</strong> Web sitesinin temel fonksiyonlarının çalışması için elzem olan çerezlerdir.</li>
                <li><strong>Performans ve Analitik Çerezleri:</strong> Ziyaretçilerin siteyi nasıl kullandığını anlamamıza yardımcı olur. (Örn: Hangi sayfalarda daha çok vakit geçiriliyor).</li>
            </ul>
            <p><strong>Çerezleri Nasıl Yönetebilirsiniz?</strong></p>
            <p>Tarayıcınızın ayarlarını değiştirerek çerezlere ilişkin tercihlerinizi yönetebilir, çerezleri tamamen reddedebilir veya silinmesini sağlayabilirsiniz.</p>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end">
            <button onclick="document.getElementById('cookieModal').classList.add('hidden')" class="px-6 py-2 bg-pamir-brand text-white rounded-xl font-semibold hover:bg-blue-700 transition-colors">Kabul Et ve Kapat</button>
        </div>
    </div>
</div>

