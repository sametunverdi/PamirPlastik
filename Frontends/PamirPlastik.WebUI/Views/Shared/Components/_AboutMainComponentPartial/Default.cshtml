@inject PamirPlastik.WebUI.Services.LocalizationService Localizer
@model PamirPlastik.WebUI.DTOs.AboutDtos.ResultAboutDto

<section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">

            <div class="lg:col-span-5 space-y-8">
                <div class="w-20 h-2 bg-[#ffda44] rounded-full"></div>

                @* Ana Başlık - Font weight 'font-black' zaten en üst seviye, 
                   ama 'tracking-tighter' ile harf arasını daraltarak daha yoğun gösterdik *@
                <h2 class="text-4xl md:text-5xl font-black text-[#0f172a] leading-tight tracking-tighter">
                    @Html.Raw(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.MainTitle_EN) ? Model.MainTitle_EN : Model.MainTitle_TR)
                </h2>

                @* Alt Başlık - 'font-bold' yerine 'font-black' yaparak daha dolgun yaptık *@
                <p class="text-gray-500 font-black text-sm uppercase tracking-[0.2em] italic">
                    "@(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.SubTitle_EN) ? Model.SubTitle_EN : Model.SubTitle_TR)"
                </p>
            </div>

            <div class="lg:col-span-7">
                @* 'text-gray-600' yerine 'text-gray-800' ve 'font-medium' yerine 'font-bold' kullanarak paragrafları belirginleştirdik *@
                <div class="prose prose-lg text-gray-800 font-bold leading-relaxed space-y-6">

                    @* İlk Paragraf *@
                    <p class="leading-8">
                        @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Description1_EN) ? Model.Description1_EN : Model.Description1_TR)
                    </p>

                    @* Vurgulu Söz (Mavi Kutulu Alan) *@
                    <div class="p-8 bg-blue-50 border-l-8 border-[#ffda44] rounded-r-3xl my-10 shadow-sm">
                        <p class="text-[#0f172a] font-black text-2xl leading-snug">
                            @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.HighlightQuote_EN) ? Model.HighlightQuote_EN : Model.HighlightQuote_TR)
                        </p>
                    </div>

                    @* İkinci Paragraf *@
                    <p class="leading-8">
                        @(Localizer.CurrentLanguage == "en" && !string.IsNullOrWhiteSpace(Model.Description2_EN) ? Model.Description2_EN : Model.Description2_TR)
                    </p>

                </div>
            </div>
        </div>
    </div>
</section>
