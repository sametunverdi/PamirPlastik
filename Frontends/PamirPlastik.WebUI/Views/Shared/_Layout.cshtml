<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Pamir Plastik | Global Üretici</title>
    <meta name="description" content="@ViewData["Description"]" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pamir: {
                            brand: '#4A5FC1', // Kurumsal Mavi
                            dark: '#1e293b',
                            light: '#f8fafc'
                        }
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #4A5FC1;
            border-radius: 10px;
        }

        /* Navbar Sticky Gölgesi */
        .nav-scrolled {
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.1);
        }

        /* Native HTML detay (accordion) için oku gizleme */
        details > summary {
            list-style: none;
        }

            details > summary::-webkit-details-marker {
                display: none;
            }
    </style>
</head>
<body class="bg-gray-50 text-gray-900 overflow-x-hidden flex flex-col min-h-screen">

    @await Component.InvokeAsync("_LayoutTopbarComponentPartial")

    <header id="main-header" class="sticky top-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-28 transition-all duration-300" id="nav-container">

                <nav class="hidden lg:flex w-5/12 justify-start space-x-8">
                    <a href="/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">Ana Sayfa<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>
                    <a href="/About/Index/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">Hakkımızda<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>
                    <a href="/Product/Index/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">Ürünler<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </nav>

                <div class="flex lg:w-2/12 justify-center flex-shrink-0">
                    <a href="/" class="flex flex-col items-center group">
                        <img id="header-logo" src="/images/logo-blue.png" alt="Pamir Plastik" class="h-20 lg:h-24 w-auto transform group-hover:scale-105 transition-all duration-300" />
                    </a>
                </div>

                <nav class="hidden lg:flex w-5/12 justify-end items-center space-x-8">
                    <a href="/Category/Index/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">Kategoriler<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>
                    <a href="/Fair/Index/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">Fuarlar<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>
                    <a href="/Contact/Index/" class="relative group py-2 font-semibold text-gray-700 hover:text-[#ffda44] transition-colors">İletişim<span class="absolute bottom-0 left-0 w-0 h-0.5 bg-[#ffda44] shadow-[0_0_10px_#ffda44] transition-all duration-300 group-hover:w-full"></span>
                    </a>

                    <div class="relative group cursor-pointer border-l-2 border-gray-200 pl-6 flex items-center gap-1 font-bold text-gray-700 py-2">
                        <img src="https://flagcdn.com/w20/tr.png" width="20" class="rounded-[2px] shadow-sm" alt="TR">
                        <svg class="w-4 h-4 transition-transform group-hover:rotate-180 text-[#ffda44]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                        <div class="absolute right-0 top-full mt-0 w-32 bg-white shadow-xl border border-gray-100 rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 translate-y-2 group-hover:translate-y-0">
                            <div class="py-2">
                                <a href="?lang=tr" class="block px-4 py-2 text-sm font-bold text-pamir-brand bg-blue-50/50 flex items-center gap-2"><img src="https://flagcdn.com/w20/tr.png" width="20" class="rounded-[2px] shadow-sm" alt="TR"> Türkçe</a>
                                <a href="?lang=en" class="block px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 hover:text-[#ffda44] transition-colors flex items-center gap-2"><img src="https://flagcdn.com/w20/gb.png" width="20" class="rounded-[2px] shadow-sm" alt="EN"> English</a>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="flex lg:hidden w-1/2 justify-end items-center">
                    <button id="mobile-menu-btn" class="p-2 text-gray-800 hover:text-[#ffda44] transition-colors">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[60] hidden opacity-0 transition-opacity duration-300"></div>

    <div id="mobile-menu-panel" class="fixed top-0 right-0 w-[85%] max-w-sm h-full bg-white z-[70] shadow-2xl transform translate-x-full transition-transform duration-500 ease-in-out flex flex-col overflow-hidden">

        <div class="flex items-center justify-between px-6 py-6 border-b border-gray-100 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex flex-col">
                <span class="text-2xl font-black text-pamir-brand tracking-tighter leading-none">PAMİR</span>
                <span class="text-[9px] font-bold text-gray-400 tracking-[0.3em] uppercase">Plastik</span>
            </div>
            <button id="close-menu-btn" class="p-2.5 bg-white rounded-2xl text-gray-400 hover:text-red-500 hover:bg-red-50 transition-all shadow-sm border border-gray-100">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto px-6 py-8 space-y-4">

            <a href="/" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">Ana Sayfa</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <a href="/About/Index" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-10V4m0 10V4m-4 14h.01M9 18h.01M19 10h.01M1M19 14h.01M1M12 18h.01M1M12 7h.01M1M12 11h.01M1M12 14h.01M15 11h.01M15 14h.01M15 18h.01M15 7h.01"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">Hakkımızda</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <a href="/Product/Index" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">Ürünler</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <a href="/Category/Index" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">Kategoriler</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <a href="/Fair" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">Fuarlar</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <a href="/Contact" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-[#4A5FC1] shadow-lg shadow-blue-200 transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    </div>
                    <span class="text-base font-extrabold text-white">İletişim</span>
                </div>
                <svg class="w-5 h-5 text-white/50 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
            <a href="/Contact/Index?openJobModal=true" class="group flex items-center justify-between py-4 px-5 rounded-2xl bg-gray-50 hover:bg-[#0f172a] transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-pamir-brand shadow-sm group-hover:bg-[#ffda44] group-hover:text-[#0f172a] transition-all">
                        <i class="fa-solid fa-briefcase text-lg"></i>
                    </div>
                    <span class="text-base font-extrabold text-gray-800 group-hover:text-white transition-colors">İş Başvurusu</span>
                </div>
                <svg class="w-5 h-5 text-gray-300 group-hover:text-[#ffda44] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>

            <details class="group mt-6">
                <summary class="flex items-center justify-between py-4 px-5 cursor-pointer bg-white border border-gray-100 rounded-2xl transition-all hover:border-[#ffda44]">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-pamir-brand">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path></svg>
                        </div>
                        <span class="text-sm font-bold text-gray-600 uppercase flex items-center gap-2">Dil: <img src="https://flagcdn.com/w20/tr.png" width="20" class="rounded-[2px] shadow-sm" alt="TR"></span>
                    </div>
                    <svg class="w-5 h-5 text-gray-400 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </summary>
                <div class="px-5 py-2 space-y-1 mt-2">
                    <a href="?lang=tr" class="flex items-center gap-3 py-3 px-4 text-sm font-bold text-pamir-brand bg-blue-50 rounded-xl border-l-4 border-pamir-brand"><img src="https://flagcdn.com/w20/tr.png" width="20" class="rounded-[2px] shadow-sm" alt="TR"> Türkçe</a>
                    <a href="?lang=en" class="flex items-center gap-3 py-3 px-4 text-sm font-bold text-gray-500 hover:text-pamir-brand transition-colors"><img src="https://flagcdn.com/w20/gb.png" width="20" class="rounded-[2px] shadow-sm" alt="EN"> English</a>
                </div>
            </details>
        </div>

        
    </div>

    <main class="flex-grow">
        @* Başlık Parçasını Buraya Çağırıyoruz *@
        @if (ViewData["HideHeader"] == null)
        {
            @await Html.PartialAsync("_PageHeaderPartial")
        }

        @* Sayfanın geri kalan içeriği buradan aşağı akacak *@
        @RenderBody()
    </main>

    @await Component.InvokeAsync("_LayoutFooterComponentPartial")

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Navbar Scroll
            const header = document.getElementById("main-header");
            const navContainer = document.getElementById("nav-container");
            const logo = document.getElementById("header-logo");
              window.addEventListener('scroll', function() {
                  if (window.scrollY > 40) {
                      header.classList.add("nav-scrolled", "py-0");
                      navContainer.classList.replace("h-28", "h-20");
                      if(logo) {
                          logo.classList.replace("h-20", "h-14");
                          logo.classList.replace("lg:h-24", "lg:h-16");
                      }
                  } else {
                      header.classList.remove("nav-scrolled", "py-0");
                      navContainer.classList.replace("h-20", "h-28");
                      if(logo) {
                          logo.classList.replace("h-14", "h-20");
                          logo.classList.replace("lg:h-16", "lg:h-24");
                      }
                  }
              });

            // Mobil Menü
            const openBtn = document.getElementById('mobile-menu-btn');
            const closeBtn = document.getElementById('close-menu-btn');
            const overlay = document.getElementById('mobile-menu-overlay');
            const panel = document.getElementById('mobile-menu-panel');

            function openMenu() {
                overlay.classList.remove('hidden');
                setTimeout(() => { overlay.classList.remove('opacity-0'); panel.classList.remove('translate-x-full'); }, 10);
                document.body.style.overflow = 'hidden';
            }

            function closeMenu() {
                overlay.classList.add('opacity-0'); panel.classList.add('translate-x-full');
                document.body.style.overflow = '';
                setTimeout(() => { overlay.classList.add('hidden'); }, 300);
            }

            openBtn.addEventListener('click', openMenu);
            closeBtn.addEventListener('click', closeMenu);
            overlay.addEventListener('click', closeMenu);
        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

