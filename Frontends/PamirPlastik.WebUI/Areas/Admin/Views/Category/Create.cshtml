@model PamirPlastik.WebUI.DTOs.CategoryDtos.CreateCategoryDto
@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Yeni Kategori Ekle</h1>
        <p class="text-slate-500 text-sm mt-1">Sisteme yeni bir ürün kategorisi ekleyin.</p>
    </div>
    <a href="/Admin/Category" class="inline-flex items-center justify-center px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">
        <i class="fa-solid fa-arrow-left mr-2"></i> Listeye Dön
    </a>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <form method="post" action="/Admin/Category/Create" class="p-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Türkçe Ad -->
            <div>
                <label for="Name_TR" class="block text-sm font-medium text-slate-700 mb-1">Kategori Adı (TR) <span class="text-red-500">*</span></label>
                <input type="text" id="Name_TR" name="Name_TR" required class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="Örn: Mutfak Gereçleri">
            </div>
            
            <!-- İngilizce Ad -->
            <div>
                <label for="Name_EN" class="block text-sm font-medium text-slate-700 mb-1">Kategori Adı (EN) <span class="text-red-500">*</span></label>
                <input type="text" id="Name_EN" name="Name_EN" required class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="Örn: Kitchenware">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Türkçe Açıklama -->
            <div>
                <label for="Description_TR" class="block text-sm font-medium text-slate-700 mb-1">Kısa Açıklama (TR)</label>
                <textarea id="Description_TR" name="Description_TR" rows="3" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="Kategori için Türkçe kısa açıklama"></textarea>
            </div>
            
            <!-- İngilizce Açıklama -->
            <div>
                <label for="Description_EN" class="block text-sm font-medium text-slate-700 mb-1">Kısa Açıklama (EN)</label>
                <textarea id="Description_EN" name="Description_EN" rows="3" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="Kategori için İngilizce kısa açıklama"></textarea>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Görsel URL -->
            <div>
                <label for="ImageUrl" class="block text-sm font-medium text-slate-700 mb-1">Kapak Fotoğrafı URL</label>
                <input type="text" id="ImageUrl" name="ImageUrl" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="/images/categories/mutfak.jpg">
                <p class="text-xs text-slate-500 mt-1">Görselin tam veya göreceli yolunu giriniz.</p>
            </div>
            
            <!-- Slug -->
            <div>
                <label for="Slug" class="block text-sm font-medium text-slate-700 mb-1">SEO URL (Slug)</label>
                <input type="text" id="Slug" name="Slug" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors" placeholder="mutfak-gerecleri">
                <p class="text-xs text-slate-500 mt-1">Boş bırakırsanız Türkçe isminden otomatik oluşturulacaktır.</p>
            </div>
        </div>

        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/Category" class="px-5 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-md text-sm font-medium transition-colors">İptal</a>
            <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
                <i class="fa-solid fa-check mr-2"></i> Kaydet
            </button>
        </div>
        
    </form>
</div>
