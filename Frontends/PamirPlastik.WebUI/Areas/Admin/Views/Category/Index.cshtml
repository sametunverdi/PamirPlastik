@model List<PamirPlastik.WebUI.DTOs.CategoryDtos.ResultCategoryDto>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Kategoriler</h1>
        <p class="text-slate-500 text-sm mt-1">Sitede gösterilecek ürün kategorilerini buradan yönetebilirsiniz.</p>
    </div>
    <a href="/Admin/Category/Create" class="inline-flex items-center justify-center px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold transition-all shadow-md shadow-indigo-600/20 hover:-translate-y-0.5">
        <i class="fa-solid fa-plus mr-2"></i> Yeni Kategori Ekle
    </a>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-20 px-4">
            <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-tags text-4xl text-slate-300"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">Kategori Bulunamadı</h3>
            <p class="text-slate-500 mb-6 max-w-sm mx-auto">Sistemde henüz bir kategori oluşturulmamış. Ürünlerinizi gruplamak için ilk kategorinizi şimdi oluşturun.</p>
            <a href="/Admin/Category/Create" class="inline-flex items-center px-5 py-2.5 border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 rounded-xl font-bold transition-colors">
                İlk Kategoriyi Ekle
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap lg:whitespace-normal">
                <thead>
                    <tr class="bg-slate-50/80 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th class="px-6 py-4 font-bold w-16 text-center">#ID</th>
                        <th class="px-6 py-4 font-bold w-16 text-center">Görsel</th>
                        <th class="px-6 py-4 font-bold">Kategori Adı (TR / EN)</th>
                        <th class="px-6 py-4 font-bold text-center">Ana Sayfa</th>
                        <th class="px-6 py-4 font-bold text-center">Durum</th>
                        <th class="px-6 py-4 font-bold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-indigo-50/30 transition-colors bg-white text-slate-700 group" id="row-@item.CategoryID">
                            <td class="px-6 py-4 text-center font-bold text-slate-400">@item.CategoryID</td>
                            <td class="px-6 py-4 text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name_TR" class="w-12 h-12 rounded-lg object-cover border border-slate-200 shadow-sm mx-auto" />
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 mx-auto">
                                        <i class="fa-solid fa-image"></i>
                                    </div>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <div class="font-bold text-slate-900 text-base mb-0.5">@item.Name_TR</div>
                                <div class="text-xs font-medium text-slate-500">@item.Name_EN</div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (item.ShowOnHome)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-700 border border-blue-200">
                                        <i class="fa-solid fa-house text-[10px]"></i> Gösteriliyor
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-500 border border-slate-200">
                                        <i class="fa-solid fa-house-chimney-crack text-[10px]"></i> Gizli
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (item.Status)
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">Aktif</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-200">Pasif</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2 opacity-100 lg:opacity-60 lg:group-hover:opacity-100 transition-opacity">
                                    <a href="/Admin/Category/Edit/@item.CategoryID" class="w-9 h-9 rounded-xl flex items-center justify-center text-indigo-600 hover:bg-indigo-100 transition-colors bg-indigo-50" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="w-9 h-9 rounded-xl flex items-center justify-center text-rose-600 hover:bg-rose-100 transition-colors bg-rose-50" title="Sil" onclick="deleteCategory(@item.CategoryID)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function deleteCategory(id) {
            const swalResult = await Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu kategoriyi silmek istediğinize emin misiniz? (Bağlı ürünler varsa hata alabilirsiniz)',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (swalResult.isConfirmed) {
                try {
                    const response = await fetch(`/Admin/Category/DeleteCategory/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        if(typeof showToast === 'function') showToast("Kategori başarıyla silindi", "success");
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        if(typeof showToast === 'function') showToast(data.message || "Silme işlemi başarısız oldu", "error");
                    }
                } catch (error) {
                    if(typeof showToast === 'function') showToast("Sistemsel bir hata oluştu", "error");
                }
            }
        }
    </script>
}