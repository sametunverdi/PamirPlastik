@model PamirPlastik.WebUI.DTOs.ContactDtos.UpdateContactDto
@{
    ViewData["Title"] = "İletişim Ayarları";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">İletişim Ayarları</h1>
    <p class="text-slate-500 text-sm mt-1">Sitenin İletişim sayfasındaki adres, telefon, e-posta ve harita bilgilerini güncelleyin.</p>
</div>

<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden mb-8">
    <div class="p-8">
        <form method="post" action="/Admin/Contact/Index" class="space-y-10">
            <input type="hidden" name="ContactID" value="@Model?.ContactID" />

            <!-- 1. Genel Bilgiler -->
            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-building text-pamir-brand"></i> Genel Merkex Bilgileri
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Başlı+ (TR)</label>
                        <input type="text" name="Title_TR" value="@Model?.Title_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Başlık (EN)</label>
                        <input type="text" name="Title_EN" value="@Model?.Title_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (TR)</label>
                        <textarea name="Description_TR" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">>@Model?.Description_TR</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (EN)</label>
                        <textarea name="Description_EN" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">@Model?.Description_EN</textarea>
                    </div>
                </div>
            </div>

            <!-- 2. Telefon -->
            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-phone text-pamir-brand"></i> Telefon
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="md:col-span-1">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Telefon Numarası</label>
                        <input type="text" name="Phone" value="@Model?.Phone" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Başlık (TR)</label>
                            <input type="text" name="PhoneTitle_TR" value="@Model?.PhoneTitle_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Başlık (EN)</label>
                            <input type="text" name="PhoneTitle_EN" value="@Model?.PhoneTitle_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (TR)</label>
                            <input type="text" name="PhoneDescription_TR" value="@Model?.PhoneDescription_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (EN)</label>
                            <input type="text" name="PhoneDescription_EN" value="@Model?.PhoneDescription_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. E-Posta -->
            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-envelope text-pamir-brand"></i> E-Posta
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="md:col-span-1">
                        <label class="block text-sm font-bold text-slate-700 mb-2">E-Posta Adresi</label>
                        <input type="email" name="Email" value="@Model?.Email" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Başlık (TR)</label>
                            <input type="text" name="EmailTitle_TR" value="@Model?.EmailTitle_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Başlık (EN)</label>
                            <input type="text" name="EmailTitle_EN" value="@Model?.EmailTitle_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (TR)</label>
                            <input type="text" name="EmailDescription_TR" value="@Model?.EmailDescription_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Açıklama (EN)</label>
                            <input type="text" name="EmailDescription_EN" value="@Model?.EmailDescription_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4. Harita & Adres -->
            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-map-location-dot text-pamir-brand"></i> Harita ve Adres
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-2">Harita (Iframe Embed Linki)</label>
                        <textarea name="MapLocation" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium font-mono text-slate-600">@Model?.MapLocation</textarea>
                        <p class="text-xs text-slate-500 mt-2 ml-1">Google Maps'ten

                        alınan <code>&lt;iframe src="..."&gt;</code> kodundaki src linkini veya tamamını buraya yapıştırın.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Harita Başlığı (TR)</label>
                        <input type="text" name="MapTitle_TR" value="@Model?.MapTitle_TR" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Harita Başlığı (EN)</label>
                        <input type="text" name="MapTitle_EN" value="@Model?.MapTitle_EN" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Adres (TR)</label>
                        <textarea name="Address_TR" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">@Model?.Address_TR</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Adres (EN)</label>
                        <textarea name="Address_EN" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium">@Model?.Address_EN</textarea>
                    </div>
                </div>
            </div>

            <div class="pt-6 mt-2 border-t border-slate-100 flex justify-end">
                <button type="submit" class="px-10 py-3.5 bg-[#0f172a] hover:bg-pamir-brand hover:text-[#0f172a] text-white rounded-2xl font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i> Ayarları Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Sosyal Medya Hesapları Kısalyolu -->
<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-8">
        <div class="flex justify-between items-center mb-6 pb-3 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-share-nodes text-pamir-brand"></i> Sosyal Medya Hesapları

            </h3>
            <a href="/Admin/SosyalMedia/Create" class="px-4 py-2 bg-[#0f172a] text-white rounded-xl text-sm font-bold hover:bg-pamir-brand transition-colors">
                <i class="fa-solid fa-plus mr-1"></i> Yeni Ekle
            </a>
        </div>
        
        <div class="flex flex-wrap gap-4">
            @if(ViewBag.SocialMedias != null && ((IEnumerable<PamirPlastik.WebUI.DTOs.SocialMediaDtos.ResultSocialMediaDto>)ViewBag.SocialMedias).Any())
            {
                foreach(var sm in (ViewBag.SocialMedias as IEnumerable<PamirPlastik.WebUI.DTOs.SocialMediaDtos.ResultSocialMediaDto>))
                {
                    <a href="/Admin/SocialMedia/Edit/@sm.SocialMediaID" class="group flex items-center gap-3 px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl hover:border-pamir-brand transition-all">
                        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-slate-600 group-hover:text-pamir-brand shadow-sm">
                            <i class="@sm.IconClass text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-800">@sm.PlatformName</p>
                            <p class="text-xs text-slate-500 font-medium">@(sm.IsActive ? "Aktif" : "Pasif")</p>
                        </div>
                    </a>
                }
            }
            else
            {
                <p class="text-sm text-slate-500">Henüz sosyal medya hesabı eklenmemiş.</p>
            }
        </div>
    </div>
</div>

<script>
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
        Swal.fire({
            title: 'Başarılı!',
            text: @Html.Raw(Json.Serialize(TempData["SuccessMessage"])),
            icon: 'success',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#0f172a'
        });
        </text>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
        Swal.fire({
            title: 'Hata!',
            text: @Html.Raw(Json.Serialize(TempData["ErrorMessage"])),
            icon: 'error',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#ef4444'
        });
        </text>
    }
</script>