@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YÜCE KURUCU KAPISI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Orbitron:wght@700&display=swap" rel="stylesheet">
    
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #050000;
            overflow: hidden;
            font-family: 'Cinzel', serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Ateş Animasyonu Arka Planı */
        .fire-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 100%, #5a0000 0%, #1a0000 50%, #000000 100%);
            z-index: 1;
        }

        .fire-particles {
            position: absolute;
            width: 100%;
            height: 100%;
            z-index: 2;
            background-image: 
                radial-gradient(#ff5500 1px, transparent 1px),
                radial-gradient(#ffaa00 1px, transparent 1px);
            background-size: 50px 50px, 30px 30px;
            background-position: 0 0, 15px 15px;
            animation: riseUp 10s linear infinite;
            opacity: 0.3;
        }

        @@keyframes riseUp {
            0% { background-position: 0 0, 15px 15px; }
            100% { background-position: 0 -500px, 15px -300px; }
        }

        /* Ana İçerik Konteyneri */
        .boss-container {
            position: relative;
            z-index: 10;
            text-align: center;
            padding: 3rem;
            background: rgba(20, 0, 0, 0.7);
            border: 2px solid #8a0000;
            box-shadow: 0 0 50px rgba(255, 50, 0, 0.4), inset 0 0 30px rgba(255, 0, 0, 0.2);
            border-radius: 20px;
            backdrop-filter: blur(5px);
            animation: pulse-border 3s infinite alternate;
        }

        @@keyframes pulse-border {
            0% { border-color: #5a0000; box-shadow: 0 0 20px rgba(255, 50, 0, 0.2); }
            100% { border-color: #ff3300; box-shadow: 0 0 70px rgba(255, 50, 0, 0.6); }
        }

        /* Övgü Yazısı - Parlayan Altın Ateş Efekti */
        .title-gold {
            font-size: 2.5rem;
            font-weight: 900;
            color: #ffd700;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 1rem;
            text-shadow: 0 0 10px #ff5500, 0 0 20px #ff0000, 0 0 30px #ff0000;
            animation: fire-flicker 2s infinite;
        }
        
        .subtitle {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            color: #ff8800;
            letter-spacing: 6px;
            margin-bottom: 3rem;
            text-shadow: 0 0 10px #ff0000;
        }

        @@keyframes fire-flicker {
            0%, 100% { text-shadow: 0 0 10px #ff5500, 0 0 20px #ff0000; opacity: 1; }
            50% { text-shadow: 0 0 25px #ffaa00, 0 0 40px #ff5500; opacity: 0.8; }
            75% { text-shadow: 0 0 15px #ff0000, 0 0 30px #aa0000; opacity: 0.9; }
        }

        /* FOR BOSS Butonu */
        .btn-boss {
            background: linear-gradient(45deg, #aa0000, #ff3300);
            color: white;
            font-size: 1.5rem;
            font-weight: bold;
            padding: 15px 40px;
            border: 2px solid #ffcc00;
            border-radius: 50px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 3px;
            box-shadow: 0 0 20px rgba(255, 50, 0, 0.8);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .btn-boss:hover {
            transform: scale(1.1);
            box-shadow: 0 0 40px #ffaa00, 0 0 60px #ff0000;
            background: linear-gradient(45deg, #ff3300, #ffaa00);
            color: #000;
        }

        /* Modal (Şifre Kutusu) */
        #passwordModal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 100;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(10px);
        }

        .modal-content {
            background: #110000;
            border: 2px solid #ff3300;
            padding: 40px;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 0 50px #ff0000;
            animation: dropIn 0.4s ease-out;
        }

        @@keyframes dropIn {
            0% { transform: translateY(-100px) scale(0.8); opacity: 0; }
            100% { transform: translateY(0) scale(1); opacity: 1; }
        }

        .boss-input {
            background: #000;
            border: 1px solid #ff5500;
            color: #ffaa00;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            padding: 10px 20px;
            width: 100%;
            margin: 20px 0;
            text-align: center;
            outline: none;
        }
        .boss-input:focus {
            box-shadow: 0 0 15px #ff5500;
        }
        
        .error-msg {
            color: #ff0000;
            font-family: sans-serif;
            font-weight: bold;
            text-shadow: 0 0 5px red;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <!-- Arka Plan Ateş Efekti -->
    <div class="fire-bg"></div>
    <div class="fire-particles"></div>

    <!-- Ortadaki Yazı ve Buton -->
    <div class="boss-container">
        
        @if (TempData["BossError"] != null)
        {
            <div class="error-msg text-xl mb-4 uppercase">
                <i class="fa-solid fa-skull"></i> @TempData["BossError"]
            </div>
        }

        <div class="absolute -top-20 right-4 text-7xl drop-shadow-[0_0_20px_rgba(255,50,0,1)] animate-bounce" style="z-index: 50;">🐉🔥</div>
        <h1 class="title-gold">YÜCE KODLARIN EFENDİSİ</h1>
        <div class="subtitle">FULL STACK DEVELOPER SAMET ÜNVERDİ</div>
        
        <p class="text-gray-400 font-sans text-sm mb-8 italic tracking-widest max-w-lg mx-auto">
            DİKKAT: Yalnızca yegane kurucu bu kapıdan geçebilir. 
            Fani adminler geride kalsın.
        </p>

        <button onclick="openModal()" class="btn-boss">
            FOR BOSS
        </button>
    </div>

    <!-- Gizli Şifre Ekranı -->
    <div id="passwordModal">
        <div class="modal-content">
            <h2 class="title-gold" style="font-size: 1.5rem;">KİMLİĞİNİ KANITLA</h2>
            <form method="post" action="/Admin/DeveloperSetting/VerifyBoss">
                <input type="password" name="password" class="boss-input" placeholder="Gizli Şifre..." required autocomplete="off" autofocus>
                <button type="submit" class="btn-boss" style="font-size: 1rem; padding: 10px 30px;">DOĞRULA VE GİR</button>
                <br><br>
                <a href="#" onclick="closeModal()" class="text-gray-500 hover:text-red-500 font-sans text-sm transition-colors">Geri Dön (Korktum)</a>
            </form>
        </div>
    </div>

    <script>
        function openModal() {
            document.getElementById('passwordModal').style.display = 'flex';
        }
        function closeModal() {
            document.getElementById('passwordModal').style.display = 'none';
        }
        
        // Eger hata mesaji varsa modali acik tutalim
        @if (TempData["BossError"] != null)
        {
            <text>
                setTimeout(openModal, 500);
            </text>
        }
    </script>
</body>
</html>
