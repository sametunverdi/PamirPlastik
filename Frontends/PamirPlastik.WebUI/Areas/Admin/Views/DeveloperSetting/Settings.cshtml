@model PamirPlastik.WebUI.DTOs.DeveloperSettingDtos.UpdateDeveloperSettingDto
@{
    ViewData["Title"] = "Geliştirici İmzası Ayarları";
}

<style>
    /* Patron Odası Özel Efektleri */
    .boss-room-container {
        position: relative;
        border: 2px solid transparent;
        background-clip: padding-box;
        border-radius: 2rem;
    }
    .boss-room-container::before {
        content: '';
        position: absolute;
        top: -2px; bottom: -2px; left: -2px; right: -2px;
        background: linear-gradient(90deg, #ff0000, #ffaa00, #ff0000);
        background-size: 200% 200%;
        z-index: -1;
        border-radius: 2.1rem;
        animation: fire-border 2s linear infinite;
    }
    @@keyframes fire-border {
        0% { background-position: 0% 50%; }
        100% { background-position: 100% 50%; }
    }
    .dragon-gif {
        position: absolute;
        top: -80px;
        right: -30px;
        width: 150px;
        pointer-events: none;
        z-index: 10;
        filter: drop-shadow(0 0 10px rgba(255,50,0,0.8));
    }
</style>

<div class="mb-6 flex justify-between items-start relative">
    <div>
        <h1 class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-red-600 to-orange-500 flex items-center gap-3">
            <i class="fa-solid fa-crown text-orange-500"></i> YÜCE KURUCU ODASI
        </h1>
        <p class="text-slate-500 font-semibold mt-2">Sistemin kalbine hoş geldin. Buradaki ayarlar doğrudan Yüce Kurucu'yu temsil eder.</p>
    </div>
    
    <a href="/Admin/DeveloperSetting/BossLogout" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-red-600 to-red-800 hover:from-red-500 hover:to-red-700 text-white font-bold rounded-xl shadow-lg hover:shadow-red-500/50 transition-all transform hover:scale-105 border border-red-400">
        <i class="fa-solid fa-person-walking-arrow-right"></i> Tahttan İn (Çıkış Yap)
    </a>
</div>

<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 mb-8 boss-room-container relative">
    <div class="absolute -top-12 -right-6 text-6xl drop-shadow-[0_0_15px_rgba(255,50,0,0.9)] animate-pulse" style="z-index: 10;">🐉🔥</div>
    <div class="p-8">
        <form method="post" action="/Admin/DeveloperSetting/Settings" class="space-y-8">
            <input type="hidden" name="DeveloperSettingID" value="@Model?.DeveloperSettingID" />

            <div>
                <h3 class="text-lg font-bold text-slate-800 mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-code text-[#dc2626]"></i> İmza Detayları
                </h3>
                
                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">İmza Önü Metni</label>
                        <input type="text" name="SignatureText" value="@Model?.SignatureText" placeholder="Örn: Bu web projesi gururla" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-[#dc2626]/20 focus:border-[#dc2626] outline-none transition-all text-sm font-medium">
                        <p class="text-xs text-slate-400 mt-1">Geliştirici isminden önce yer alacak açıklama metni.</p>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Geliştirici Adı / Markası</label>
                        <input type="text" name="DeveloperName" value="@Model?.DeveloperName" placeholder="Örn: AKU CODE" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-[#dc2626]/20 focus:border-[#dc2626] outline-none transition-all text-sm font-medium text-[#dc2626]">
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Yönlendirilecek URL</label>
                        <input type="url" name="DeveloperUrl" value="@Model?.DeveloperUrl" placeholder="Örn: https://sametaku.com" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-[#dc2626]/20 focus:border-[#dc2626] outline-none transition-all text-sm font-medium text-blue-600">
                    </div>
                </div>
            </div>

            <div class="flex justify-end pt-4 border-t border-slate-100">
                <button type="submit" class="px-8 py-3 bg-slate-900 hover:bg-[#dc2626] text-white rounded-2xl font-bold shadow-lg hover:shadow-xl hover:shadow-[#dc2626]/20 transition-all flex items-center gap-2">
                    <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>