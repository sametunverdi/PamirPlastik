@model List<PamirPlastik.WebUI.DTOs.ColorDtos.ResultColorDto>

@{
    ViewData["Title"] = "Renkler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Alpine.js -->
<script src="https://cdn.jsdelivr.net/npm/alpinejs@3.13.3/dist/cdn.min.js" defer></script>

<!-- Page header -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <!-- Left: Title -->
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Renkler</h1>
        <p class="text-slate-500 text-sm mt-1">Sistemdeki tüm renk paletinizi buradan yönetebilirsiniz.</p>
    </div>
    <!-- Right: Actions -->
    <div>
        <a href="/Admin/Color/Create" class="inline-flex items-center justify-center px-4 py-2 bg-gradient-to-r from-primary to-primary-dark hover:from-primary-dark hover:to-primary text-white rounded-xl font-semibold shadow-lg shadow-primary/30 transform hover:-translate-y-0.5 transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
            <i class="fa-solid fa-plus mr-2"></i> Yeni Renk Ekle
        </a>
    </div>
</div>

<div class="bg-white shadow-xl shadow-slate-200/40 rounded-2xl border border-slate-200 overflow-hidden" x-data="colorTable()">
    
    @if(Model.Count == 0)
    {
        <div class="px-6 py-10 text-center text-slate-500">
            <div class="flex flex-col items-center justify-center">
                <i class="fa-solid fa-palette text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-lg font-bold text-slate-900 mb-2">Renk Bulunamadı</h3>
                <p class="text-slate-500 mb-6 max-w-sm mx-auto">Sistemde henüz hiçbir renk eklenmemiş. Ürünlerinize atayacağınız ilk rengi şimdi ekleyin.</p>
                <a href="/Admin/Color/Create" class="inline-flex items-center px-5 py-2.5 border-2 border-indigo-600 text-indigo-600 hover:bg-indigo-50 rounded-xl font-bold transition-colors">
                    İlk Rengi Ekle
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- TOOLBAR: SEARCH -->
        <div class="p-4 border-b border-slate-200 bg-slate-50/50 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <h2 class="font-semibold text-slate-800 text-lg">Tüm Renkler</h2>
                <div class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold" x-text="'Toplam: ' + totalItems"></div>
            </div>

            <!-- SEARCH BAR -->
            <div class="relative w-full md:w-64 flex-shrink-0">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fa-solid fa-magnifying-glass text-slate-400"></i>
                </div>
                <input type="text" x-model="search" placeholder="Renk Adı veya Kodu..." class="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-shadow bg-white">
            </div>
        </div>
        
        <div class="p-0">
            <div class="overflow-x-auto min-h-[300px]">
                <table class="w-full text-left border-collapse" x-show="totalItems > 0">
                    <thead class="text-xs font-semibold text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4">Renk</th>
                            <th class="px-6 py-4">Renk Adı (TR)</th>
                            <th class="px-6 py-4">Renk Adı (EN)</th>
                            <th class="px-6 py-4">Hex Kodu</th>
                            <th class="px-6 py-4 text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr class="color-row hover:bg-slate-50/70 transition-colors group" 
                                data-name-tr="@(item.Name_TR?.ToLower())"
                                data-name-en="@(item.Name_EN?.ToLower())"
                                data-code="@(item.HexCode?.ToLower())">
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center justify-center w-10 h-10 rounded-xl shadow-sm border border-slate-200 transform group-hover:scale-110 transition-transform duration-300" style="background-color: @item.HexCode"></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="font-semibold text-slate-800">@item.Name_TR</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-slate-600 font-medium">@item.Name_EN</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 bg-slate-100 text-slate-600 rounded-lg text-xs font-bold tracking-wider">@item.HexCode</span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
                                    <a href="/Admin/Color/Edit/@item.ColorID" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-orange-50 text-orange-500 hover:bg-orange-500 hover:text-white transition-colors tooltip" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square text-sm"></i>
                                    </a>
                                    <button type="button" onclick="confirmDelete('/Admin/Color/Delete/@item.ColorID')" class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-rose-50 text-rose-500 hover:bg-rose-500 hover:text-white transition-colors tooltip" title="Sil">
                                        <i class="fa-solid fa-trash text-sm"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                
                <!-- EMPTY STATE FOR SEARCH -->
                <div x-show="totalItems === 0" class="py-12 text-center" style="display: none;">
                    <div class="text-slate-400 mb-2"><i class="fa-solid fa-magnifying-glass text-3xl"></i></div>
                    <h4 class="text-slate-600 font-bold">Sonuç Bulunamadı</h4>
                    <p class="text-slate-400 text-sm">Arama kriterlerinize uyan renk bulunmuyor.</p>
                </div>
            </div>
        </div>

        <!-- PAGINATION FOOTER -->
        <div x-show="totalItems > 0" class="border-t border-slate-200 p-4 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-slate-500 font-medium">
                Toplam <span class="font-bold text-slate-800" x-text="totalItems"></span> renk arasından 
                <span class="font-bold text-slate-800" x-text="(page - 1) * perPage + 1"></span> - 
                <span class="font-bold text-slate-800" x-text="Math.min(page * perPage, totalItems)"></span> arası gösteriliyor
            </div>
            
            <div class="flex items-center gap-2">
                <button @@click="prevPage()" :disabled="page === 1" 
                        :class="page === 1 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-slate-200'"
                        class="px-3 py-1.5 border border-slate-300 bg-white text-slate-600 rounded-lg text-sm font-semibold transition-colors">
                    Önceki
                </button>
                
                <!-- Page Indicator -->
                <div class="px-4 py-1.5 text-sm font-bold text-slate-700">
                    <span x-text="page"></span> / <span x-text="totalPages"></span>
                </div>
                
                <button @@click="nextPage()" :disabled="page === totalPages || totalPages === 0" 
                        :class="page === totalPages || totalPages === 0 ? 'opacity-50 cursor-not-allowed' : 'hover:bg-slate-200'"
                        class="px-3 py-1.5 border border-slate-300 bg-white text-slate-600 rounded-lg text-sm font-semibold transition-colors">
                    Sonraki
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.data('colorTable', () => ({
                search: '',
                page: 1,
                perPage: 10,
                totalItems: 0,
                
                init() {
                    this.updateView();
                    this.$watch('search', () => { this.page = 1; this.updateView(); });
                    this.$watch('page', () => this.updateView());
                },
                
                get totalPages() {
                    return Math.max(1, Math.ceil(this.totalItems / this.perPage));
                },
                
                prevPage() {
                    if (this.page > 1) this.page--;
                },
                
                nextPage() {
                    if (this.page < this.totalPages) this.page++;
                },
                
                updateView() {
                    const rows = Array.from(document.querySelectorAll('.color-row'));
                    const searchLower = this.search.toLowerCase();
                    let visibleRows = [];
                    
                    // Arama
                    rows.forEach(row => {
                        const nameTR = row.getAttribute('data-name-tr') || '';
                        const nameEN = row.getAttribute('data-name-en') || '';
                        const code = row.getAttribute('data-code') || '';
                        
                        const matchesSearch = nameTR.includes(searchLower) || nameEN.includes(searchLower) || code.includes(searchLower);
                        
                        if (matchesSearch) {
                            visibleRows.push(row);
                        } else {
                            row.style.display = 'none';
                        }
                    });
                    
                    this.totalItems = visibleRows.length;
                    
                    // Sayfalama
                    const start = (this.page - 1) * this.perPage;
                    const end = start + this.perPage;
                    
                    visibleRows.forEach((row, index) => {
                        if (index >= start && index < end) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                }
            }));
        });

        async function confirmDelete(url) {
            const swalResult = await Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu rengi silmek istediğinize emin misiniz? Bu işlem geri alınamaz.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (swalResult.isConfirmed) {
                window.location.href = url;
            }
        }
    </script>
}