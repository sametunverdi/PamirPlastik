<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pamir Plastik Yönetim</title>
    
    <!-- Google Fonts: Outfit -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS (CDN) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            DEFAULT: '#4F46E5', // Indigo 600
                            dark: '#3730A3', // Indigo 800
                            light: '#818CF8' // Indigo 400
                        },
                        secondary: {
                            DEFAULT: '#0EA5E9', // Sky 500
                            dark: '#0284C7',
                            light: '#38BDF8'
                        },
                        accent: {
                            DEFAULT: '#F43F5E', // Rose 500
                            dark: '#E11D48'
                        },
                        darkbase: {
                            DEFAULT: '#0F172A', // Slate 900
                            lighter: '#1E293B' // Slate 800
                        }
                    }
                }
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        #sidebar nav::-webkit-scrollbar { width: 4px; }
        #sidebar nav::-webkit-scrollbar-track { background: transparent; }
        #sidebar nav::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        #sidebar nav::-webkit-scrollbar-thumb:hover { background: #ffda44; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans flex h-screen overflow-hidden selection:bg-primary selection:text-white">
    
    <!-- Mobile Sidebar Overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <aside id="sidebar" class="bg-gradient-to-b from-[#0f172a] via-[#151f32] to-[#050505] text-slate-300 w-64 flex-shrink-0 flex flex-col fixed lg:static inset-y-0 left-0 z-50 transform -translate-x-full lg:translate-x-0 transition-all duration-300 ease-in-out shadow-[10px_0_20px_rgba(0,0,0,0.5)] border-r border-slate-700/50">
        <!-- Logo -->
        <div class="h-20 flex items-center justify-center border-b border-slate-700 bg-[#0f172a]">
            <a href="/Admin">
                <img src="/images/logo-white.png" alt="Pamir Plastik" class="h-10 w-auto hover:scale-105 transition-transform" />
            </a>
        </div>
        
        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto py-6 px-4 space-y-6">
            @{
                var currentUrl = Context.Request.Path.ToString().ToLower();
                
                string GetLinkClass(string path) {
                    bool isActive = false;
                    if (path == "/admin") {
                        isActive = (currentUrl == "/admin" || currentUrl == "/admin/" || currentUrl.Contains("/admin/dashboard"));
                    } else {
                        isActive = currentUrl == path || currentUrl.StartsWith(path + "/");
                    }
                    return isActive 
                        ? "flex items-center px-4 py-2.5 bg-gradient-to-r from-primary-dark/60 to-primary/10 text-white rounded-xl font-bold transition-all shadow-[0_0_15px_rgba(79,70,229,0.15)] border-l-4 border-[#ffda44]" 
                        : "flex items-center px-4 py-2.5 rounded-xl hover:bg-slate-800/50 hover:text-white transition-all font-medium text-slate-400 group border-l-4 border-transparent hover:border-slate-600";
                }
                
                string GetIconClass(string path) {
                    bool isActive = false;
                    if (path == "/admin") {
                        isActive = (currentUrl == "/admin" || currentUrl == "/admin/" || currentUrl.Contains("/admin/dashboard"));
                    } else {
                        isActive = currentUrl == path || currentUrl.StartsWith(path + "/");
                    }
                    return isActive ? "text-[#ffda44] w-5 text-center mr-3 drop-shadow-[0_0_8px_rgba(255,218,68,0.6)]" : "text-slate-500 w-5 text-center mr-3 group-hover:text-white group-hover:-translate-y-1 group-hover:scale-110 transition-all duration-300";
                }
            }

            <!-- DASHBOARD -->
            <div>
                <a href="/Admin" class="@GetLinkClass("/admin")">
                    <i class="fa-solid fa-chart-line @GetIconClass("/admin")"></i> <span class="text-sm tracking-wide">Dashboard</span>
                </a>
            </div>

            <!-- ANA SAYFA YÖNETİMİ -->
            <div>
                <div class="relative mt-8 mb-4">
                <h3 class="px-4 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Ana Sayfa Yönetimi</h3>
                <div class="absolute bottom-0 left-4 w-[80%] h-[1px] bg-gradient-to-r from-[#ffda44]/40 via-slate-700/50 to-transparent"></div>
            </div>
                <div class="space-y-1">
                    <a href="/Admin/HomePageSetting/Edit" class="@GetLinkClass("/admin/homepagesetting")">
                        <i class="fa-solid fa-home @GetIconClass("/admin/homepagesetting")"></i> <span class="text-sm tracking-wide">Ana Sayfa Ayarları</span>
                    </a>
                    <a href="/Admin/Fair" class="@GetLinkClass("/admin/fair")">
                        <i class="fa-solid fa-calendar-alt @GetIconClass("/admin/fair")"></i> <span class="text-sm tracking-wide">Fuarlar Bölümü</span>
                    </a>
                </div>
            </div>

            <!-- ÜRÜN YÖNETİMİ -->
            <div>
                <div class="relative mt-8 mb-4">
                <h3 class="px-4 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Ürün Yönetimi</h3>
                <div class="absolute bottom-0 left-4 w-[80%] h-[1px] bg-gradient-to-r from-[#ffda44]/40 via-slate-700/50 to-transparent"></div>
            </div>
                <div class="space-y-1">
                    <a href="/Admin/Category" class="@GetLinkClass("/admin/category")">
                        <i class="fa-solid fa-tags @GetIconClass("/admin/category")"></i> <span class="text-sm tracking-wide">Kategoriler</span>
                    </a>
                    <a href="/Admin/Product" class="@GetLinkClass("/admin/product")">
                        <i class="fa-solid fa-box @GetIconClass("/admin/product")"></i> <span class="text-sm tracking-wide">Ürünler</span>
                    </a>
                    <a href="/Admin/Color" class="@GetLinkClass("/admin/color")">
                        <i class="fa-solid fa-palette @GetIconClass("/admin/color")"></i> <span class="text-sm tracking-wide">Renkler</span>
                    </a>
                </div>
            </div>

            <!-- KURUMSAL YÖNETİM -->
            <div>
                <div class="relative mt-8 mb-4">
                <h3 class="px-4 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">Kurumsal Yönetim</h3>
                <div class="absolute bottom-0 left-4 w-[80%] h-[1px] bg-gradient-to-r from-[#ffda44]/40 via-slate-700/50 to-transparent"></div>
            </div>
                <div class="space-y-1">
                    <a href="/Admin/About" class="@GetLinkClass("/admin/about")">
                        <i class="fa-solid fa-building @GetIconClass("/admin/about")"></i> <span class="text-sm tracking-wide">Kurumsal Ayarlar</span>
                    </a>
                    
                    
                </div>
            </div>

            <!-- İLETİŞİM & SİSTEM -->
            <div>
                <div class="relative mt-8 mb-4">
                <h3 class="px-4 text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-2">İletişim & Sistem</h3>
                <div class="absolute bottom-0 left-4 w-[80%] h-[1px] bg-gradient-to-r from-[#ffda44]/40 via-slate-700/50 to-transparent"></div>
            </div>
                <div class="space-y-1">
                    <a href="/Admin/Contact" class="@GetLinkClass("/admin/contact")">
                        <i class="fa-solid fa-address-book @GetIconClass("/admin/contact")"></i> <span class="text-sm tracking-wide">İletişim Bilgileri</span>
                    </a>
                    <a href="/Admin/SocialMedia" class="@GetLinkClass("/admin/socialmedia")">
                        <i class="fa-brands fa-instagram @GetIconClass("/admin/socialmedia")"></i> <span class="text-sm tracking-wide">Sosyal Medya</span>
                    </a>
                                          <a href="/Admin/Message" class="@GetLinkClass("/admin/message")">
                          <i class="fa-solid fa-envelope @GetIconClass("/admin/message")"></i> <span class="text-sm tracking-wide">Gelen Mesajlar</span>
                      </a>
                    <a href="/Admin/JobApplication" class="@GetLinkClass("/admin/jobapplication")">
                        <i class="fa-solid fa-briefcase @GetIconClass("/admin/jobapplication")"></i> <span class="text-sm tracking-wide">İş Başvuruları</span>
                    </a>
                    
                    <hr class="border-gray-700/50 my-2 mx-4" />
                      <a href="/Admin/DeveloperSetting" class="@GetLinkClass("/admin/developersetting")">
                          <i class="fa-solid fa-code @GetIconClass("/admin/developersetting")"></i> <span class="text-sm tracking-wide text-[#dc2626] font-bold">Geliştirici Ayarları</span>
                      </a>
                </div>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-[#f8fafc]">
        <!-- Topbar -->
        <header class="h-16 bg-white/80 backdrop-blur-md border-b border-slate-200/60 shadow-sm flex items-center justify-between px-4 lg:px-8 z-10 flex-shrink-0 sticky top-0">
            <div class="flex items-center flex-1">
                <button onclick="toggleSidebar()" class="lg:hidden text-slate-500 hover:text-primary p-2 -ml-2 mr-2 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-primary/30">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
                
                <!-- Page Title -->
                <div class="hidden sm:block ml-4">
                    <h2 class="text-xl font-bold text-slate-800">@ViewData["Title"]</h2>
                </div>
            </div>
            <div class="flex items-center gap-4 ml-4">
                <a href="/" target="_blank" class="hidden sm:inline-flex items-center px-4 py-2 bg-primary/10 text-primary hover:bg-primary hover:text-white rounded-xl text-sm font-semibold transition-all">
                    <i class="fa-solid fa-globe mr-2"></i> Siteyi Gör
                </a>
                <a href="/" target="_blank" class="sm:hidden text-primary hover:text-primary-dark p-2 bg-primary/10 rounded-xl">
                    <i class="fa-solid fa-globe text-lg"></i>
                </a>
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-secondary text-white flex items-center justify-center font-bold shadow-md shadow-primary/20 cursor-pointer hover:shadow-lg transition-shadow">
                    P
                </div>
            </div>
        </header>

        <!-- Main Area -->
        <main class="flex-1 overflow-y-auto p-4 lg:p-8">
            @RenderBody()
        </main>
        @await Component.InvokeAsync("_AdminDeveloperSignatureComponentPartial")
    </div>

    <!-- Admin Script (General functions like toggleSidebar) -->
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        // Global Toast Notification using basic DOM manipulation (Tailwind classes)
        function showToast(message, type = 'success') {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();
            
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-50 border-green-400 text-green-800' : 'bg-red-50 border-red-400 text-red-800';
            const icon = type === 'success' ? 'fa-check-circle text-green-500' : 'fa-exclamation-circle text-red-500';
            
            toast.className = `flex items-center p-4 mb-4 border-l-4 rounded shadow-md transition-all duration-300 transform translate-x-full ${bgColor}`;
            toast.innerHTML = `
                <i class="fa-solid ${icon} mr-3 text-lg"></i>
                <div class="text-sm font-medium">${message}</div>
            `;
            
            toastContainer.appendChild(toast);
            
            // Animate in
            setTimeout(() => {
                toast.classList.remove('translate-x-full');
            }, 10);
            
            // Remove after 3 seconds
            setTimeout(() => {
                toast.classList.add('translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'fixed bottom-4 right-4 z-[9999] flex flex-col gap-2 max-w-sm w-full';
            document.body.appendChild(container);
            return container;
        }

        // Table Filtering Function
        function filterTable() {
            var input = document.getElementById("globalSearchInput");
            if (!input) return;
            var filter = input.value.toLocaleUpperCase('tr-TR');
            
            // Sayfadaki ilk tablonun tbody kısmını al
            var tbody = document.querySelector("table tbody");
            if (!tbody) return;
            
            var tr = tbody.getElementsByTagName("tr");
            
            // Loop through all table rows, and hide those who don't match the search query
            for (var i = 0; i < tr.length; i++) {
                var rowContainsFilter = false;
                var td = tr[i].getElementsByTagName("td");
                for (var j = 0; j < td.length; j++) {
                    if (td[j]) {
                        var txtValue = td[j].textContent || td[j].innerText;
                        if (txtValue.toLocaleUpperCase('tr-TR').indexOf(filter) > -1) {
                            rowContainsFilter = true;
                            break;
                        }
                    }
                }
                tr[i].style.display = rowContainsFilter ? "" : "none";
            }
        }

        // Global Fetch Wrapper
        async function fetchApi(url, options = {}) {
            const config = {
                ...options,
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                    ...options.headers
                }
            };

            try {
                const response = await fetch(url, config);
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                if (response.status === 204) return null;
                return await response.json();
            } catch (error) {
                console.error("API Fetch Error:", error);
                showToast("Bir hata oluştu: " + error.message, "error");
                throw error;
            }
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@TempData["SuccessMessage"]', 'success');
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                showToast('@TempData["ErrorMessage"]', 'error');
            });
        </script>
    }
</body>
</html>

