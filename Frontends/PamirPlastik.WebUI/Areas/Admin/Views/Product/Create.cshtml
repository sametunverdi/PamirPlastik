@model PamirPlastik.WebUI.DTOs.ProductDtos.CreateProductDto
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .field-label { font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; display: block; color: #64748b; }
    .modern-input {
        width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem;
        border: 1.5px solid #e2e8f0; font-size: 0.875rem; color: #1e293b;
        background: #f8fafc; transition: all 0.2s;
    }
    .modern-input:focus {
        outline: none; border-color: #6366f1; background: #ffffff;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }
    .toggle-checkbox:checked { right: 0; border-color: #6366f1; }
    .toggle-checkbox:checked + .toggle-label { background-color: #6366f1; }
    
    .color-checkbox:checked + label {
        border-color: #6366f1;
        background-color: #e0e7ff;
    }
</style>

<div class="mb-6 flex items-center justify-between">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Yeni Ürün Ekle</h1>
        <p class="text-slate-500 text-sm mt-1">Sisteme detaylı bir ürün tanımlayın.</p>
    </div>
    <a href="/Admin/Product/Index" class="inline-flex items-center px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl font-semibold transition-all shadow-sm">
        <i class="fa-solid fa-arrow-left mr-2"></i> Listeye Dön
    </a>
</div>

<form method="post" enctype="multipart/form-data" class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        
        <!-- Sol Kolon: Ana Bilgiler & Teknik Detaylar -->
        <div class="xl:col-span-2 space-y-6">
            
            <!-- 1. İsim ve Kategori -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-cube text-indigo-500"></i> Temel Bilgiler</h3>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="field-label">🇹🇷 Ürün Adı (TR)</label>
                            <input type="text" asp-for="Name_TR" class="modern-input font-bold" required />
                        </div>
                        <div>
                            <label class="field-label">🇬🇧 Ürün Adı (EN)</label>
                            <input type="text" asp-for="Name_EN" class="modern-input font-bold" />
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="field-label">Kategori</label>
                            @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.v, "Lütfen Kategori Seçin", new { @class = "modern-input", required = "required" })
                        </div>
                        <div>
                            <label class="field-label">Ürün Kodu</label>
                            <input type="text" asp-for="ProductCode" class="modern-input font-mono" placeholder="Örn: PMR-101" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Açıklamalar -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-align-left text-indigo-500"></i> Açıklamalar</h3>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="field-label">Kısa Açıklama (TR)</label>
                            <textarea asp-for="ShortDescription_TR" rows="2" class="modern-input text-sm"></textarea>
                        </div>
                        <div>
                            <label class="field-label">Kısa Açıklama (EN)</label>
                            <textarea asp-for="ShortDescription_EN" rows="2" class="modern-input text-sm"></textarea>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="field-label">Uzun/Detaylı Açıklama (TR)</label>
                            <textarea asp-for="FullDescription_TR" rows="4" class="modern-input text-sm"></textarea>
                        </div>
                        <div>
                            <label class="field-label">Uzun/Detaylı Açıklama (EN)</label>
                            <textarea asp-for="FullDescription_EN" rows="4" class="modern-input text-sm"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Teknik Özellikler -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-wrench text-indigo-500"></i> Teknik Özellikler</h3>
                </div>
                <div class="p-6">
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <label class="field-label">Koli İçi Adet</label>
                            <input type="number" asp-for="BoxCount" class="modern-input" placeholder="Örn: 24" />
                        </div>
                        <div>
                            <label class="field-label">Hacim / Kapasite</label>
                            <input type="text" asp-for="Capacity" class="modern-input" placeholder="Örn: 2 Litre" />
                        </div>
                        <div>
                            <label class="field-label">Hammadde</label>
                            <input type="text" asp-for="Material" class="modern-input" placeholder="Örn: PP" />
                        </div>
                        <div>
                            <label class="field-label">Koli Ölçüsü</label>
                            <input type="text" asp-for="BoxSize" class="modern-input" placeholder="Örn: 60x40x40" />
                        </div>
                        <div>
                            <label class="field-label">Koli Ağırlığı</label>
                            <input type="text" asp-for="BoxWeight" class="modern-input" placeholder="Örn: 12.5 Kg" />
                        </div>
                    </div>

                    <div class="mt-6 flex flex-wrap gap-6">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" asp-for="IsDishwasherSafe" class="w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                            <span class="text-sm font-bold text-slate-700"><i class="fa-solid fa-soap text-slate-400"></i> Bulaşık Makinesine Uygun</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" asp-for="IsFoodSafe" class="w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500">
                            <span class="text-sm font-bold text-slate-700"><i class="fa-solid fa-utensils text-slate-400"></i> Gıda Temasına Uygun</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 4. Renkler (Çoklu Seçim) -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-palette text-indigo-500"></i> Üretim Renkleri</h3>
                </div>
                <div class="p-6">
                    <div class="flex flex-wrap gap-3">
                        @if (ViewBag.Colors != null)
                        {
                            foreach (var color in ViewBag.Colors)
                            {
                                <div class="relative">
                                    <input type="checkbox" id="color-@color.ColorID" name="ColorIDs" value="@color.ColorID" class="sr-only color-checkbox" />
                                    <label for="color-@color.ColorID" class="flex items-center gap-2 px-3 py-2 border-2 border-slate-200 rounded-xl cursor-pointer transition-all hover:bg-slate-50">
                                        <span class="w-5 h-5 rounded-full shadow-sm" style="background-color: @color.HexCode;"></span>
                                        <span class="text-sm font-bold text-slate-700">@color.Name_TR</span>
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="text-xs text-slate-400">Sistemde kayıtlı renk bulunamadı.</span>
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Sağ Kolon: Görseller, Vitrin & Kaydet -->
        <div class="space-y-6">
            
            <!-- Görünürlük / Vitrin -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-sliders text-indigo-500"></i> Görünürlük & Vitrin</h3>
                </div>
                <div class="p-6 space-y-5">
                    
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="font-bold text-slate-800 text-sm">Yıldızlı (Vitrinde) Göster</div>
                            <div class="text-xs text-slate-500 mt-0.5">Ürün ana sayfada sergilenir</div>
                        </div>
                        <div class="relative inline-block w-12 align-middle select-none transition duration-200 ease-in">
                            <input type="checkbox" asp-for="IsFeatured" id="toggle-home" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer" />
                            <label for="toggle-home" class="toggle-label block overflow-hidden h-6 rounded-full bg-slate-300 cursor-pointer"></label>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                        <div>
                            <div class="font-bold text-slate-800 text-sm">Sıra (Order)</div>
                            <div class="text-xs text-slate-500 mt-0.5">Küçük numara üstte çıkar</div>
                        </div>
                        <div>
                            <input type="number" asp-for="Order" value="0" class="modern-input w-20 text-center !p-1.5" />
                        </div>
                    </div>

                </div>
            </div>

            <!-- Ana Kapak Resmi -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-regular fa-image text-indigo-500"></i> Ana Kapak Görseli</h3>
                </div>
                <div class="p-6">
                    <div class="mt-2 flex justify-center rounded-xl border-2 border-dashed border-slate-300 px-6 py-8 hover:bg-slate-50 transition-colors bg-slate-50/50 group">
                        <div class="text-center">
                            <i class="fa-solid fa-cloud-arrow-up text-4xl text-indigo-400 mb-3 group-hover:scale-110 transition-transform"></i>
                            <div class="mt-2 flex text-sm leading-6 text-slate-600 justify-center">
                                <label for="main-file-upload" class="relative cursor-pointer rounded-md font-bold text-indigo-600 focus-within:outline-none hover:text-indigo-500">
                                    <span>Ana Resmi Seç</span>
                                    <input id="main-file-upload" name="imageFile" type="file" class="sr-only" accept="image/*" required>
                                </label>
                            </div>
                            <p class="text-xs leading-5 text-slate-500 mt-1">Sadece 1 adet (Kapak)</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Çoklu Galeri -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-indigo-50/50 px-6 py-4 border-b border-indigo-100/50">
                    <h3 class="font-bold text-indigo-900 flex items-center gap-2"><i class="fa-solid fa-images text-indigo-500"></i> Alt Galeri (İsteğe Bağlı)</h3>
                </div>
                <div class="p-6">
                    <div class="mt-2 flex justify-center rounded-xl border-2 border-dashed border-slate-300 px-6 py-8 hover:bg-slate-50 transition-colors bg-slate-50/50 group">
                        <div class="text-center">
                            <i class="fa-solid fa-layer-group text-4xl text-indigo-400 mb-3 group-hover:scale-110 transition-transform"></i>
                            <div class="mt-2 flex text-sm leading-6 text-slate-600 justify-center">
                                <label for="gallery-upload" class="relative cursor-pointer rounded-md font-bold text-indigo-600 focus-within:outline-none hover:text-indigo-500">
                                    <span>Çoklu Resim Seç</span>
                                    <input id="gallery-upload" name="galleryImages" type="file" class="sr-only" accept="image/*" multiple>
                                </label>
                            </div>
                            <p class="text-xs leading-5 text-slate-500 mt-1">Ctrl basarak çoklu seçebilirsin</p>
                        </div>
                    </div>
                    <div id="gallery-preview" class="grid grid-cols-3 gap-2 mt-4 empty:hidden">
                        <!-- Seçilen küçük galeri resimleri buraya eklenecek -->
                    </div>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full flex items-center justify-center px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold transition-all shadow-lg shadow-indigo-600/30 hover:-translate-y-1 text-lg">
                    <i class="fa-solid fa-check mr-2"></i> Ürünü Kaydet
                </button>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <script>

        // Ana resim önizleme
        document.getElementById("main-file-upload").addEventListener("change", function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    let previewDiv = document.getElementById("main-preview-container");
                    if (!previewDiv) {
                        previewDiv = document.createElement("div");
                        previewDiv.id = "main-preview-container";
                        previewDiv.className = "mt-4 relative rounded-lg overflow-hidden border border-slate-200";
                        document.getElementById("main-file-upload").closest(".text-center").appendChild(previewDiv);
                    }
                    previewDiv.innerHTML = `<img src="${e.target.result}" class="w-full h-32 object-contain" />`;
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // Çoklu resim önizleme
        document.getElementById('gallery-upload').addEventListener('change', function(e) {
            const preview = document.getElementById('gallery-preview');
            preview.innerHTML = '';
            Array.from(e.target.files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.innerHTML += `
                        <div class="relative rounded-lg overflow-hidden border border-slate-200">
                            <img src="${e.target.result}" class="w-full h-16 object-cover" />
                        </div>
                    `;
                }
                reader.readAsDataURL(file);
            });
        });
    </script>
}


