@model List<PamirPlastik.WebUI.DTOs.ProductDtos.ResultProductDto>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-800">Ürünler</h1>
    <a href="/Admin/Product/Create" class="inline-flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
        <i class="fa-solid fa-plus mr-2"></i> Yeni Ürün Ekle
    </a>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-16 px-4">
            <i class="fa-solid fa-box-open text-5xl mb-4 text-slate-300"></i>
            <h3 class="text-lg font-medium text-slate-900 mb-1">Ürün Bulunamadı</h3>
            <p class="text-slate-500 mb-6">Sistemde henüz bir ürün oluşturulmamış.</p>
            <a href="/Admin/Product/Create" class="inline-flex items-center px-4 py-2 border border-primary text-primary hover:bg-blue-50 rounded-md font-medium transition-colors">
                İlk Ürünü Ekle
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap lg:whitespace-normal">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th class="px-6 py-3 font-semibold">Görsel / Ad</th>
                        <th class="px-6 py-3 font-semibold">Kategori</th>
                        <th class="px-6 py-3 font-semibold">Ürün Kodu</th>
                        <th class="px-6 py-3 font-semibold text-center">Yıldızlı (Öne Çıkan)</th>
                        <th class="px-6 py-3 font-semibold text-center">Durum</th>
                        <th class="px-6 py-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-teal-50 transition-colors bg-white text-slate-700" id="row-@item.ProductID">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="h-10 w-10 flex-shrink-0 bg-slate-100 rounded-md overflow-hidden flex items-center justify-center border border-slate-200">
                                        @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                        {
                                            <img class="h-10 w-10 object-cover" src="@item.MainImageUrl" alt="">
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-image text-slate-300"></i>
                                        }
                                    </div>
                                    <div class="ml-4">
                                        <div class="font-semibold text-slate-900">@item.Name_TR</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                @if (!string.IsNullOrEmpty(item.CategoryName))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
                                        @item.CategoryName
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 font-mono text-xs text-slate-600">@item.ProductCode</td>
                            <td class="px-6 py-4 text-center">
                                @if (item.IsFeatured)
                                {
                                    <i class="fa-solid fa-star text-amber-dark text-lg" title="Öne Çıkan Ürün"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star text-slate-300" title="Standart Ürün"></i>
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (item.Status)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">Aktif</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">Pasif</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/Admin/Product/Edit/@item.ProductID" class="w-8 h-8 rounded-md flex items-center justify-center text-teal hover:bg-teal-50 transition-colors focus:outline-none focus:ring-2 focus:ring-teal/50" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-red-600 hover:bg-red-50 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500/50" title="Sil" onclick="deleteProduct(@item.ProductID)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function deleteProduct(id) {
            if (confirm("Bu ürünü silmek istediğinize emin misiniz?")) {
                try {
                    const response = await fetch(`/Admin/Product/DeleteProduct/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        if(typeof showToast === 'function') showToast("Ürün başarıyla silindi", "success");
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        if(typeof showToast === 'function') showToast(data.message || "Silme işlemi başarısız oldu", "error");
                    }
                } catch (error) {
                    if(typeof showToast === 'function') showToast("Sistemsel bir hata oluştu", "error");
                }
            }
        }
    </script>
}