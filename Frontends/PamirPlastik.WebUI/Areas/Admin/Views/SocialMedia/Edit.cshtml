@model PamirPlastik.WebUI.DTOs.SocialMediaDtos.UpdateSocialMediaDto
@{
    ViewData["Title"] = "Sosyal Medya Düzenle";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Sosyal Medya Hesabını Düzenle</h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <form method="post" action="/Admin/SocialMedia/Edit" class="p-6 space-y-6">
        <input type="hidden" name="SocialMediaID" value="@Model.SocialMediaID" />
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Sosyal Medya Adı</label>
            <input type="text" name="PlatformName" value="@Model.PlatformName" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Profil URL</label>
            <input type="url" name="Url" value="@Model.Url" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">İkon Sınıfı (FontAwesome)</label>
            <input type="text" name="IconClass" value="@Model.IconClass" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
        </div>
        
        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/SocialMedia" class="px-6 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">İptal</a>
            <button type="submit" class="px-6 py-2 bg-[#4A5FC1] hover:bg-[#374796] text-white rounded-lg shadow-md transition-colors">
                <i class="fa-solid fa-save mr-2"></i> Güncelle
            </button>
        </div>
    </form>
</div>