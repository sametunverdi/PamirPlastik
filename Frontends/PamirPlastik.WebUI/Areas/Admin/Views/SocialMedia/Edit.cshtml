@model PamirPlastik.WebUI.DTOs.SocialMediaDtos.UpdateSocialMediaDto
@{
    ViewData["Title"] = "Sosyal Medya Düzenle";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Sosyal Medya Düzenle</h1>
    <p class="text-slate-500 text-sm mt-1">Sosyal medya bağlantılızın bilgilerini güncelleyin.</p>
</div>

<div class="bg-white rounded-[2rem] shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-8">
        <form method="post" action="/Admin/SocialMedia/Edit" class="space-y-6 max-w-2xl">
            <input type="hidden" name="SocialMediaID" value="@Model.SocialMediaID" />
            
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Sosyal Medya Adı</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fa-solid fa-hashtag text-slate-400"></i>
                    </div>
                    <input type="text" name="PlatformName" value="@Model.PlatformName" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium" required>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">Profil URL</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fa-solid fa-link text-slate-400"></i>
                    </div>
                    <input type="url" name="Url" value="@Model.Url" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium" required>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-bold text-slate-700 mb-2">İkon Sınıfı (FontAwesome)</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                        <i class="fa-brands fa-font-awesome text-slate-400"></i>
                    </div>
                    <select name="IconClass" id="IconClassSelect" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-4 focus:ring-pamir-brand/20 focus:border-pamir-brand outline-none transition-all text-sm font-medium" required>
    <option value="" selected disabled>İkon Seçin</option>
    <option value="fa-brands fa-instagram">Instagram</option>
    <option value="fa-brands fa-facebook">Facebook</option>
    <option value="fa-brands fa-x-twitter">X (Twitter)</option>
    <option value="fa-brands fa-linkedin">LinkedIn</option>
    <option value="fa-brands fa-youtube">YouTube</option>
    <option value="fa-brands fa-tiktok">TikTok</option>
    <option value="fa-brands fa-pinterest">Pinterest</option>
    <option value="fa-brands fa-whatsapp">WhatsApp</option>
    <option value="fa-solid fa-link">Diğer (Bağlantı)</option>
</select>
                </div>
                <div class="mt-3 flex items-center gap-3">
                    <span class="text-xs font-bold text-slate-500">Mevcut İkon Önizleme:</span>
                    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-pamir-brand">
                        <i id="iconPreview" class="@Model.IconClass text-sm"></i>
                    </div>
                </div>
            </div>
            
            <div>
                <label class="flex items-center cursor-pointer group">
                    <input type="checkbox" name="IsActive" value="true" @(Model?.IsActive == true ? "checked" : "") class="w-5 h-5 text-pamir-brand bg-slate-50 border-slate-200 rounded focus:ring-pamir-brand/20 transition-all cursor-pointer">
                    <span class="ml-3 text-sm font-bold text-slate-700 group-hover:text-pamir-brand transition-colors">Sitede Aktif Olarak Gösterilsin mi?</span>
                </label>
            </div>
            
            <div class="pt-6 mt-6 border-t border-slate-100 flex gap-4">
                <button type="submit" class="flex-1 py-3.5 bg-[#0f172a] hover:bg-pamir-brand hover:text-[#0f172a] text-white rounded-2xl font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i> Güncelle
                </button>
                <a href="/Admin/SocialMedia" class="flex-1 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-2xl font-bold transition-colors flex items-center justify-center gap-2">
                    <i class="fa-solid fa-arrow-left"></i> Geri Dön
                </a>
            </div>
        </form>
    </div>
</div><script>
    document.addEventListener('DOMContentLoaded', function() {
        var select = document.getElementById('IconClassSelect');
        var currentIcon = '@Model.IconClass';
        if(currentIcon) {
            select.value = currentIcon;
        }
        
        select.addEventListener('change', function() {
            var previewIcon = document.getElementById('iconPreview');
            if(previewIcon) {
                previewIcon.className = this.value + ' text-sm';
            }
        });
    });
</script>