@model PamirPlastik.WebUI.DTOs.AboutDtos.CreateAboutImageDto
@{
    ViewData["Title"] = "Yeni Resim Ekle";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Yeni Resim Ekle</h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <form method="post" action="/Admin/AboutImage/Create" enctype="multipart/form-data" class="p-6 space-y-6">
        <div class="grid grid-cols-1 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Görsel Seç</label>
                <input type="file" name="ImageFile" accept="image/*" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Alt Metin / Açıklama (TR)</label>
                <input type="text" name="AltText_TR" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Alt Metin / Açıklama (EN)</label>
                <input type="text" name="AltText_EN" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none" required>
            </div>
        </div>
        
        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/AboutImage" class="px-6 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">İptal</a>
            <button type="submit" class="px-6 py-2 bg-[#4A5FC1] hover:bg-[#374796] text-white rounded-lg shadow-md transition-colors">
                <i class="fa-solid fa-save mr-2"></i> Kaydet
            </button>
        </div>
    </form>
</div>