@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Dashboard</h1>
        <p class="text-slate-500 text-sm mt-1">Sistemin genel durumuna göz atın.</p>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    
    <!-- Toplam Ürün -->
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl shadow-lg shadow-blue-500/20 p-6 flex items-center justify-between text-white hover:-translate-y-1 transition-all duration-300">
        <div>
            <p class="text-blue-100 font-medium mb-1 text-sm uppercase tracking-wider">Toplam Ürün</p>
            <h3 class="text-4xl font-black">@ViewBag.ProductCount</h3>
        </div>
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
            <i class="fa-solid fa-box-open text-3xl"></i>
        </div>
    </div>

    <!-- Kategoriler -->
    <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl shadow-lg shadow-purple-500/20 p-6 flex items-center justify-between text-white hover:-translate-y-1 transition-all duration-300">
        <div>
            <p class="text-purple-100 font-medium mb-1 text-sm uppercase tracking-wider">Kategoriler</p>
            <h3 class="text-4xl font-black">@ViewBag.CategoryCount</h3>
        </div>
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
            <i class="fa-solid fa-layer-group text-3xl"></i>
        </div>
    </div>

    <!-- Okunmamış Mesajlar -->
    <div class="bg-gradient-to-br from-red-500 to-rose-600 rounded-2xl shadow-lg shadow-red-500/20 p-6 flex items-center justify-between text-white hover:-translate-y-1 transition-all duration-300 relative group">
        <div>
            <p class="text-red-100 font-medium mb-1 text-sm uppercase tracking-wider">Yeni Mesajlar</p>
            <h3 class="text-4xl font-black">@ViewBag.UnreadMessageCount</h3>
        </div>
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
            <i class="fa-solid fa-envelope-open-text text-3xl group-hover:scale-110 transition-transform"></i>
        </div>
        @if(ViewBag.UnreadMessageCount > 0)
        {
            <div class="absolute -top-2 -right-2 w-5 h-5 bg-yellow-400 rounded-full animate-ping"></div>
            <div class="absolute -top-2 -right-2 w-5 h-5 bg-yellow-400 border-2 border-white rounded-full"></div>
        }
    </div>

    <!-- Yaklaşan Fuarlar -->
    <div class="bg-gradient-to-br from-teal-400 to-emerald-500 rounded-2xl shadow-lg shadow-teal-500/20 p-6 flex items-center justify-between text-white hover:-translate-y-1 transition-all duration-300">
        <div>
            <p class="text-teal-50 font-medium mb-1 text-sm uppercase tracking-wider">Yaklaşan Fuarlar</p>
            <h3 class="text-4xl font-black">@ViewBag.UpcomingFairCount</h3>
        </div>
        <div class="w-16 h-16 rounded-full bg-white/20 flex items-center justify-center backdrop-blur-sm">
            <i class="fa-solid fa-calendar-check text-3xl"></i>
        </div>
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8 text-center mt-12">
    <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fa-solid fa-cube text-primary text-4xl"></i>
    </div>
    <h2 class="text-2xl font-bold text-slate-800 mb-2">Pamir Plastik Yönetim Paneline Hoş Geldiniz</h2>
    <p class="text-slate-500 max-w-lg mx-auto">Sol taraftaki menüyü kullanarak ürünlerinizi, kategorilerinizi ve diğer kurumsal bilgilerinizi anında güncelleyebilirsiniz.</p>
    
    <div class="mt-8">
        <a href="/" target="_blank" class="inline-flex items-center px-6 py-3 bg-[#4A5FC1] text-white font-semibold rounded-lg hover:bg-[#374796] transition-colors shadow-lg shadow-indigo-500/30">
            <i class="fa-solid fa-globe mr-2"></i> Web Sitesini Görüntüle
        </a>
    </div>
</div>