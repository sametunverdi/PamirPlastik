@model PamirPlastik.WebUI.DTOs.FairDtos.UpdateFairDto
@{
    ViewData["Title"] = "Fuar Düzenle";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight mb-1">Fuar Düzenle</h1>
        <p class="text-slate-500 font-medium">Mevcut fuar kaydının detaylarını güncelleyin.</p>
    </div>
    <a href="/Admin/Fair" class="inline-flex items-center justify-center px-5 py-2.5 bg-white border-2 border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300 rounded-xl font-bold transition-all">
        <i class="fa-solid fa-arrow-left mr-2"></i> Listeye Dön
    </a>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-8 py-6 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-lg font-bold text-slate-800 flex items-center">
            <i class="fa-solid fa-calendar-check text-indigo-600 mr-2.5"></i>
            Fuar Bilgileri Güncellemesi
        </h3>
    </div>
    
    <form method="post" action="/Admin/Fair/Edit" enctype="multipart/form-data" class="p-8">
        
        <input type="hidden" name="FairID" value="@Model.FairID" />
        <input type="hidden" name="existingImg1Url" value="@Model.Img1" />
        <input type="hidden" name="existingImg2Url" value="@Model.Img2" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <!-- Fuar Adı -->
            <div>
                <label for="Name" class="block text-sm font-bold text-slate-700 mb-2">Fuar Adı <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-tag"></i>
                    </div>
                    <input type="text" id="Name" name="Name" value="@Model.Name" required class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-medium text-slate-700 transition-colors">
                </div>
            </div>
            
            <!-- Lokasyon -->
            <div>
                <label for="Location" class="block text-sm font-bold text-slate-700 mb-2">Lokasyon <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <input type="text" id="Location" name="Location" value="@Model.Location" required class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-medium text-slate-700 transition-colors">
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <!-- Tarih -->
            <div>
                <label for="Date" class="block text-sm font-bold text-slate-700 mb-2">Tarih <span class="text-rose-500">*</span></label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-regular fa-calendar"></i>
                    </div>
                    <input type="text" id="Date" name="Date" value="@Model.Date" required class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-medium text-slate-700 transition-colors">
                </div>
            </div>
            
            <!-- Stand -->
            <div>
                <label for="Stand" class="block text-sm font-bold text-slate-700 mb-2">Stant Numarası</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-store"></i>
                    </div>
                    <input type="text" id="Stand" name="Stand" value="@Model.Stand" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-medium text-slate-700 transition-colors">
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <!-- Görsel 1 -->
            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
                <label class="block text-sm font-bold text-slate-700 mb-4">Ana Fuar Görseli</label>
                
                @if (!string.IsNullOrEmpty(Model.Img1))
                {
                    <div class="mb-5">
                        <div class="text-[11px] font-bold text-slate-400 mb-2 uppercase tracking-wider">Mevcut Görsel</div>
                        <img src="@Model.Img1" id="existing-img-1" class="w-full h-40 object-cover rounded-xl border border-slate-200 shadow-sm" />
                    </div>
                }

                <div class="flex justify-center rounded-xl border-2 border-dashed border-slate-300 px-6 py-6 hover:bg-white transition-colors bg-white/50 group text-center">
                    <div>
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-indigo-400 mb-2 group-hover:scale-110 transition-transform"></i>
                        <div class="mt-1 flex text-sm leading-6 text-slate-600 justify-center">
                            <label for="Img1File" class="relative cursor-pointer rounded-md font-bold text-indigo-600 focus-within:outline-none hover:text-indigo-500">
                                <span>Yeni Resim Seç</span>
                                <input id="Img1File" name="Img1File" type="file" class="sr-only" accept="image/*">
                            </label>
                        </div>
                        <p class="text-xs leading-5 text-slate-500 mt-1">Sadece 1 adet (Ana Kapak)</p>
                    </div>
                </div>
            </div>
            
            <!-- Görsel 2 -->
            <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
                <label class="block text-sm font-bold text-slate-700 mb-4">İkinci Görsel (Opsiyonel)</label>
                
                @if (!string.IsNullOrEmpty(Model.Img2))
                {
                    <div class="mb-5">
                        <div class="text-[11px] font-bold text-slate-400 mb-2 uppercase tracking-wider">Mevcut Görsel</div>
                        <img src="@Model.Img2" id="existing-img-2" class="w-full h-40 object-cover rounded-xl border border-slate-200 shadow-sm" />
                    </div>
                }
                else
                {
                    <div class="mb-5">
                        <div class="text-[11px] font-bold text-slate-400 mb-2 uppercase tracking-wider">Mevcut Görsel Yok</div>
                        <div id="existing-img-2-placeholder" class="w-full h-40 flex items-center justify-center bg-slate-100 rounded-xl border border-slate-200 text-slate-400">
                            <i class="fa-solid fa-image text-3xl"></i>
                        </div>
                        <img src="" id="existing-img-2" class="w-full h-40 object-cover rounded-xl border border-slate-200 shadow-sm hidden" />
                    </div>
                }

                <div class="flex justify-center rounded-xl border-2 border-dashed border-slate-300 px-6 py-6 hover:bg-white transition-colors bg-white/50 group text-center">
                    <div>
                        <i class="fa-solid fa-cloud-arrow-up text-3xl text-indigo-400 mb-2 group-hover:scale-110 transition-transform"></i>
                        <div class="mt-1 flex text-sm leading-6 text-slate-600 justify-center">
                            <label for="Img2File" class="relative cursor-pointer rounded-md font-bold text-indigo-600 focus-within:outline-none hover:text-indigo-500">
                                <span>İkinci Resmi Seç</span>
                                <input id="Img2File" name="Img2File" type="file" class="sr-only" accept="image/*">
                            </label>
                        </div>
                        <p class="text-xs leading-5 text-slate-500 mt-1">Stanttan veya fuardan detay</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-8 p-5 bg-amber-50 border border-amber-100 rounded-2xl">
            <label class="flex items-start gap-4 cursor-pointer">
                <div class="relative flex-shrink-0 mt-0.5">
                    <input type="checkbox" id="IsFuture" name="IsFuture" value="true" class="sr-only peer" @(Model.IsFuture ? "checked" : "") onchange="document.getElementById('IsFutureHidden').value = this.checked ? 'true' : 'false'">
                    <input type="hidden" id="IsFutureHidden" name="IsFuture" value="@(Model.IsFuture ? "true" : "false")" />
                    <div class="w-12 h-6 bg-slate-300 rounded-full peer peer-checked:bg-indigo-600 transition-colors"></div>
                    <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-6 shadow-sm"></div>
                </div>
                <div>
                    <span class="text-base font-bold text-amber-900 block mb-0.5">Yaklaşan Fuar Olarak İşaretle</span>
                    <span class="text-sm text-amber-700/80 block leading-relaxed">Bu fuar henüz gerçekleşmediyse ve yaklaşan bir fuar ise işaretleyin. Ana sayfada "Yaklaşan Etkinlikler" veya öne çıkanlar arasında gösterilecektir.</span>
                </div>
            </label>
        </div>

        <div class="pt-6 border-t border-slate-100 flex justify-end gap-3">
            <a href="/Admin/Fair" class="px-6 py-3 bg-white border-2 border-slate-200 text-slate-700 hover:bg-slate-50 hover:border-slate-300 rounded-xl font-bold transition-all">İptal Et</a>
            <button type="submit" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold shadow-md shadow-indigo-200 transition-all focus:outline-none focus:ring-4 focus:ring-indigo-100 hover:-translate-y-0.5">
                <i class="fa-solid fa-check mr-2"></i> Değişiklikleri Kaydet
            </button>
        </div>
        
    </form>
</div>

@section Scripts {
    <script>
        // Img1 File Preview
        document.getElementById("Img1File").addEventListener("change", function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById("existing-img-1");
                    if (img) {
                        img.src = e.target.result;
                    }
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });

        // Img2 File Preview
        document.getElementById("Img2File").addEventListener("change", function(e) {
            if (e.target.files && e.target.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.getElementById("existing-img-2");
                    const placeholder = document.getElementById("existing-img-2-placeholder");
                    
                    if (placeholder) {
                        placeholder.classList.add("hidden");
                        img.classList.remove("hidden");
                    }
                    
                    if (img) {
                        img.src = e.target.result;
                    }
                }
                reader.readAsDataURL(e.target.files[0]);
            }
        });
    </script>
}
