@model PamirPlastik.WebUI.DTOs.FairDtos.UpdateFairDto
@{
    ViewData["Title"] = "Fuar Düzenle";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-800">Fuar Düzenle</h1>
        <p class="text-slate-500 text-sm mt-1">Mevcut fuar kaydının detaylarını güncelleyin.</p>
    </div>
    <a href="/Admin/Fair" class="inline-flex items-center justify-center px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">
        <i class="fa-solid fa-arrow-left mr-2"></i> Listeye Dön
    </a>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <form method="post" action="/Admin/Fair/Edit" enctype="multipart/form-data" class="p-6">
        
        <input type="hidden" name="FairID" value="@Model.FairID" />
        <input type="hidden" name="existingImg1Url" value="@Model.Img1" />
        <input type="hidden" name="existingImg2Url" value="@Model.Img2" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Fuar Adı -->
            <div>
                <label for="Name" class="block text-sm font-medium text-slate-700 mb-1">Fuar Adı <span class="text-red-500">*</span></label>
                <input type="text" id="Name" name="Name" value="@Model.Name" required class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
            
            <!-- Lokasyon -->
            <div>
                <label for="Location" class="block text-sm font-medium text-slate-700 mb-1">Lokasyon <span class="text-red-500">*</span></label>
                <input type="text" id="Location" name="Location" value="@Model.Location" required class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Tarih -->
            <div>
                <label for="Date" class="block text-sm font-medium text-slate-700 mb-1">Tarih <span class="text-red-500">*</span></label>
                <input type="text" id="Date" name="Date" value="@Model.Date" required class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
            
            <!-- Stand -->
            <div>
                <label for="Stand" class="block text-sm font-medium text-slate-700 mb-1">Stand Numarası</label>
                <input type="text" id="Stand" name="Stand" value="@Model.Stand" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <!-- Görsel 1 -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Mevcut Görsel 1 URL</label>
                <input type="text" value="@Model.Img1" readonly class="w-full px-4 py-2 border border-slate-300 rounded-md bg-slate-100 outline-none mb-2">
                
                <label for="Img1File" class="block text-sm font-medium text-slate-700 mb-1">Yeni Görsel 1 Seç</label>
                <input type="file" id="Img1File" name="Img1File" accept="image/*" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
            
            <!-- Görsel 2 -->
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Mevcut Görsel 2 URL</label>
                <input type="text" value="@Model.Img2" readonly class="w-full px-4 py-2 border border-slate-300 rounded-md bg-slate-100 outline-none mb-2">
                
                <label for="Img2File" class="block text-sm font-medium text-slate-700 mb-1">Yeni Görsel 2 Seç (Opsiyonel)</label>
                <input type="file" id="Img2File" name="Img2File" accept="image/*" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-primary/50 focus:border-primary outline-none transition-colors">
            </div>
        </div>

        <div class="mb-6">
            <label class="flex items-center gap-3 cursor-pointer">
                <div class="relative">
                    <input type="checkbox" id="IsFuture" name="IsFuture" value="true" class="sr-only" @(Model.IsFuture ? "checked" : "") onchange="document.getElementById('IsFutureHidden').value = this.checked ? 'true' : 'false'">
                    <input type="hidden" id="IsFutureHidden" name="IsFuture" value="@(Model.IsFuture ? "true" : "false")" />
                    <div class="block bg-slate-200 w-10 h-6 rounded-full transition-colors" id="toggleBg"></div>
                    <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform" id="toggleDot"></div>
                </div>
                <div>
                    <span class="text-sm font-medium text-slate-700 block">Yaklaşan Fuar</span>
                    <span class="text-xs text-slate-500 block">Bu fuar henüz gerçekleşmediyse işaretleyin (Anasayfada öne çıkar)</span>
                </div>
            </label>
        </div>

        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/Fair" class="px-5 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-md text-sm font-medium transition-colors">İptal</a>
            <button type="submit" class="px-5 py-2.5 bg-primary hover:bg-primary-dark text-white rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
                <i class="fa-solid fa-check mr-2"></i> Güncelle
            </button>
        </div>
        
    </form>
</div>

@section Scripts {
    <style>
        input:checked + #toggleBg { background-color: var(--primary-color, #1976D2); }
        input:checked ~ #toggleDot { transform: translateX(100%); }
    </style>
}
