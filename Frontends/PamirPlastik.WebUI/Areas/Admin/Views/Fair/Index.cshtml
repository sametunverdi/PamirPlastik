@model List<PamirPlastik.WebUI.DTOs.FairDtos.ResultFairDto>
@{
    ViewData["Title"] = "Fuarlar";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-800">Fuarlar</h1>
    <a href="/Admin/Fair/Create" class="inline-flex items-center justify-center px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-md font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50">
        <i class="fa-solid fa-plus mr-2"></i> Yeni Fuar Ekle
    </a>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-16 px-4">
            <i class="fa-regular fa-calendar-alt text-5xl mb-4 text-slate-300"></i>
            <h3 class="text-lg font-medium text-slate-900 mb-1">Fuar Bulunamadı</h3>
            <p class="text-slate-500 mb-6">Sistemde henüz bir fuar kaydı oluşturulmamış.</p>
            <a href="/Admin/Fair/Create" class="inline-flex items-center px-4 py-2 border border-primary text-primary hover:bg-blue-50 rounded-md font-medium transition-colors">
                İlk Fuarı Ekle
            </a>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap lg:whitespace-normal">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th class="px-6 py-3 font-semibold">Fuar Adı</th>
                        <th class="px-6 py-3 font-semibold">Tarih</th>
                        <th class="px-6 py-3 font-semibold">Lokasyon</th>
                        <th class="px-6 py-3 font-semibold">Durum</th>
                        <th class="px-6 py-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-teal-50 transition-colors bg-white text-slate-700" id="row-@item.FairID">
                            <td class="px-6 py-4 font-semibold text-slate-900">@item.Name</td>
                            <td class="px-6 py-4">@item.Date</td>
                            <td class="px-6 py-4">@item.Location</td>
                            <td class="px-6 py-4">
                                @if (item.IsFuture)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800 border border-amber-200">Yaklaşan Fuar</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">Geçmiş Fuar</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <a href="/Admin/Fair/Edit/@item.FairID" class="w-8 h-8 rounded-md flex items-center justify-center text-teal hover:bg-teal-50 transition-colors focus:outline-none focus:ring-2 focus:ring-teal/50" title="Düzenle">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <button type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-red-600 hover:bg-red-50 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500/50" title="Sil" onclick="deleteFair(@item.FairID)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function deleteFair(id) {
            if (confirm("Bu fuar kaydını silmek istediğinize emin misiniz?")) {
                try {
                    const response = await fetch(`/Admin/Fair/DeleteFair/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        if(typeof showToast === 'function') showToast("Fuar başarıyla silindi", "success");
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        if(typeof showToast === 'function') showToast(data.message || "Silme işlemi başarısız oldu", "error");
                    }
                } catch (error) {
                    if(typeof showToast === 'function') showToast("Sistemsel bir hata oluştu", "error");
                }
            }
        }
    </script>
}