@model PamirPlastik.WebUI.DTOs.ProductDtos.UpdateProductImageDto
@{
    ViewData["Title"] = "Resim Düzenle";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold text-slate-800">Ürün Resmi Düzenle</h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <form method="post" action="/Admin/ProductImage/Edit" enctype="multipart/form-data" class="p-6 space-y-6">
        <input type="hidden" name="ProductImageID" value="@Model.ProductImageID" />
        <input type="hidden" name="existingImageUrl" value="@Model.ImageUrl" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Hangi Ürün?</label>
                @Html.DropDownListFor(x => x.ProductId, (List<SelectListItem>)ViewBag.Products, "Lütfen Ürün Seçiniz", new { @class = "w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none", required = "required" })
            </div>
            
            <div class="md:col-span-2 flex items-center gap-4">
                <img src="@Model.ImageUrl" alt="Current Image" class="h-24 w-24 object-cover rounded-md border border-slate-200">
                <div class="flex-1">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Yeni Görsel Seç (Değiştirmek istemiyorsanız boş bırakın)</label>
                    <input type="file" name="ImageFile" accept="image/*" class="w-full px-4 py-2 border border-slate-300 rounded-md focus:ring-2 focus:ring-[#4A5FC1]/50 focus:border-[#4A5FC1] outline-none">
                </div>
            </div>
        </div>
        
        <div class="pt-4 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/ProductImage" class="px-6 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">İptal</a>
            <button type="submit" class="px-6 py-2 bg-[#4A5FC1] hover:bg-[#374796] text-white rounded-lg shadow-md transition-colors">
                <i class="fa-solid fa-save mr-2"></i> Güncelle
            </button>
        </div>
    </form>
</div>