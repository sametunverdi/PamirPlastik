@model List<PamirPlastik.WebUI.DTOs.ContactMessageDtos.ResultContactMessageDto>
@{
    ViewData["Title"] = "Mesajlar";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <h1 class="text-2xl font-bold text-slate-800">Mesajlar</h1>
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <!-- Header Area -->
    <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
        @{
            var unreadCount = Model?.Count(x => !x.IsRead) ?? 0;
        }
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-200">
            @unreadCount Okunmamış Mesaj
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-16 px-4">
            <i class="fa-regular fa-envelope-open text-5xl mb-4 text-slate-300"></i>
            <h3 class="text-lg font-medium text-slate-900 mb-1">Gelen Mesaj Yok</h3>
            <p class="text-slate-500">Şu anda gösterilecek bir mesaj bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse whitespace-nowrap lg:whitespace-normal">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider border-b border-slate-200">
                        <th class="px-6 py-3 font-semibold">İsim / Şirket</th>
                        <th class="px-6 py-3 font-semibold">İletişim</th>
                        <th class="px-6 py-3 font-semibold">Konu</th>
                        <th class="px-6 py-3 font-semibold">Tarih</th>
                        <th class="px-6 py-3 font-semibold">Durum</th>
                        <th class="px-6 py-3 font-semibold text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 text-sm">
                    @foreach (var item in Model.OrderByDescending(x => x.SendDate))
                    {
                        <tr class="hover:bg-teal-50 transition-colors @(!item.IsRead ? "bg-white font-semibold" : "bg-white/50 text-slate-600")" id="row-@item.ContactMessageID">
                            <td class="px-6 py-4">
                                <div class="text-slate-900">@item.FullName</div>
                                <div class="text-xs text-slate-500 font-normal mt-0.5">@item.Company</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-slate-700">@item.Email</div>
                            </td>
                            <td class="px-6 py-4 max-w-[200px] truncate" title="@item.Subject">
                                @item.Subject
                            </td>
                            <td class="px-6 py-4 text-slate-500">
                                @item.SendDate.ToString("dd MMM yyyy, HH:mm")
                            </td>
                            <td class="px-6 py-4" id="status-@item.ContactMessageID">
                                @if (item.IsRead)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">Okundu</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 border border-red-200">Okunmadı</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex justify-end gap-2">
                                    <button type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-primary hover:bg-blue-50 transition-colors focus:outline-none focus:ring-2 focus:ring-primary/50" title="Mesajı Oku" 
                                            onclick="viewMessage(@item.ContactMessageID, '@Uri.EscapeDataString(item.FullName ?? "")', '@Uri.EscapeDataString(item.Email ?? "")', '@Uri.EscapeDataString(item.Company ?? "")', '@Uri.EscapeDataString(item.Subject ?? "")', '@Uri.EscapeDataString(item.MessageDetail ?? "")', '@item.SendDate.ToString("dd MMM yyyy, HH:mm")')">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                    <button type="button" class="w-8 h-8 rounded-md flex items-center justify-center text-red-600 hover:bg-red-50 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500/50" title="Sil" onclick="deleteMessage(@item.ContactMessageID)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Overlay -->
<div id="messageModal" class="fixed inset-0 bg-slate-900/50 z-[100] hidden flex items-center justify-center p-4 sm:p-0">
    <!-- Modal Content -->
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
        
        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-slate-50">
            <h3 id="modalSubject" class="text-lg font-semibold text-slate-800 truncate pr-4">Mesaj Konusu</h3>
            <button type="button" onclick="closeModal()" class="text-slate-400 hover:text-slate-600 focus:outline-none">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>
        
        <!-- Body -->
        <div class="px-6 py-4 overflow-y-auto flex-1">
            <div class="bg-slate-50 p-4 rounded-md mb-6 border border-slate-200 text-sm">
                <div class="grid grid-cols-[80px_1fr] gap-y-2">
                    <div class="text-slate-500 font-medium">Gönderen:</div>
                    <div class="text-slate-900 font-semibold" id="modalFullName"></div>
                    
                    <div class="text-slate-500 font-medium">E-posta:</div>
                    <div class="text-slate-900 break-all"><a href="#" id="modalEmailLink" class="text-primary hover:underline"></a></div>
                    
                    <div class="text-slate-500 font-medium">Şirket:</div>
                    <div class="text-slate-900" id="modalCompany"></div>
                    
                    <div class="text-slate-500 font-medium">Tarih:</div>
                    <div class="text-slate-900" id="modalDate"></div>
                </div>
            </div>
            
            <div class="text-slate-700 whitespace-pre-wrap leading-relaxed text-sm" id="modalBody"></div>
        </div>
        
        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex justify-end gap-3 rounded-b-lg mt-auto">
            <button type="button" onclick="closeModal()" class="px-4 py-2 border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-200">Kapat</button>
            <button type="button" id="btnDeleteModalMessage" class="px-4 py-2 border border-transparent text-white bg-red-600 hover:bg-red-700 rounded-md text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2">Sil</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewMessage(id, fullName, email, company, subject, detail, date) {
            const decodedEmail = decodeURIComponent(email);
            
            document.getElementById('modalFullName').innerText = decodeURIComponent(fullName);
            document.getElementById('modalEmailLink').innerText = decodedEmail;
            document.getElementById('modalEmailLink').href = "mailto:" + decodedEmail;
            document.getElementById('modalCompany').innerText = decodeURIComponent(company) || '-';
            document.getElementById('modalSubject').innerText = decodeURIComponent(subject);
            document.getElementById('modalDate').innerText = date;
            document.getElementById('modalBody').innerText = decodeURIComponent(detail);
            
            document.getElementById('messageModal').classList.remove('hidden');
            document.body.style.overflow = 'hidden'; // Prevent scrolling underneath
            
            document.getElementById('btnDeleteModalMessage').onclick = function() {
                deleteMessage(id);
                closeModal();
            };

            markAsRead(id);
        }

        function closeModal() {
            document.getElementById('messageModal').classList.add('hidden');
            document.body.style.overflow = '';
        }

        // Close on background click
        document.getElementById('messageModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        async function markAsRead(id) {
            try {
                const response = await fetch(`/Admin/Message/MarkAsRead/${id}`, { method: 'POST' });
                const data = await response.json();
                if (data.success) {
                    const row = document.getElementById(`row-${id}`);
                    if (row) {
                        row.classList.remove('font-semibold');
                        row.classList.add('text-slate-600', 'bg-white/50');
                    }
                    const statusTd = document.getElementById(`status-${id}`);
                    if (statusTd) {
                        statusTd.innerHTML = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">Okundu</span>';
                    }
                }
            } catch (error) {
                console.error("Mark as read error", error);
            }
        }

        async function deleteMessage(id) {
            const swalResult = await Swal.fire({
            title: 'Emin misiniz?',
            text: 'Bu mesajı silmek istediğinize emin misiniz?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Evet, Sil!',
            cancelButtonText: 'İptal'
        });
        if (swalResult.isConfirmed) {
                try {
                    const response = await fetch(`/Admin/Message/DeleteMessage/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) {
                        if(typeof showToast === 'function') showToast("Mesaj başarıyla silindi", "success");
                        const row = document.getElementById(`row-${id}`);
                        if (row) row.remove();
                    } else {
                        if(typeof showToast === 'function') showToast(data.message || "Silme işlemi başarısız oldu", "error");
                    }
                } catch (error) {
                    if(typeof showToast === 'function') showToast("Sistemsel bir hata oluştu", "error");
                }
            }
        }
    </script>
}
